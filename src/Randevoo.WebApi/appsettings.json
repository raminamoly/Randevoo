{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Randevoo.WebApi"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Randevoo",
    "Audience": "Randevoo",
    "ExpiresMinutes": "15"
  },
  "Auth": {
    "RefreshTokenExpiresDays": "30"
  }
}
