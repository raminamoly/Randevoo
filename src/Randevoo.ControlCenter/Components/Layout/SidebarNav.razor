@using Randevoo.ControlCenter.Models.Common
@inject MockAuthState AuthState

<div class="brand-block">
    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Medium" />
    <div>
        <div class="brand-title">Randevoo</div>
        <div class="brand-subtitle">Control Center</div>
    </div>
</div>

<MudNavMenu Class="nav-stack" Rounded="true" Margin="Margin.Dense">
    @foreach (var item in VisibleItems)
    {
        <MudNavLink Href="@item.Href" Match="NavLinkMatch.All" Icon="@item.Icon">@item.Label</MudNavLink>
    }
</MudNavMenu>

@code {
    private static readonly NavItem[] Items =
    [
        new("Dashboard", "/dashboard", Icons.Material.Filled.Dashboard, [ControlCenterRole.Admin]),
        new("My dashboard", "/my/dashboard", Icons.Material.Filled.SpaceDashboard, [ControlCenterRole.EventPlanner]),
        new("Events", "/events", Icons.Material.Filled.Event, [ControlCenterRole.Admin]),
        new("My events", "/my/events", Icons.Material.Filled.EventNote, [ControlCenterRole.EventPlanner]),
        new("Event planners", "/event-planners", Icons.Material.Filled.Groups, [ControlCenterRole.Admin]),
        new("Participants", "/participants", Icons.Material.Filled.Badge, [ControlCenterRole.Admin]),
        new("Balances", "/balances", Icons.Material.Filled.AccountBalanceWallet, [ControlCenterRole.Admin, ControlCenterRole.EventPlanner]),
        new("Moderation", "/moderation", Icons.Material.Filled.Policy, [ControlCenterRole.Admin]),
        new("Surveys", "/surveys", Icons.Material.Filled.QueryStats, [ControlCenterRole.Admin, ControlCenterRole.EventPlanner]),
        new("Chat", "/chat", Icons.Material.Filled.Forum, [ControlCenterRole.Admin, ControlCenterRole.EventPlanner]),
        new("Settings", "/settings", Icons.Material.Filled.Settings, [ControlCenterRole.Admin, ControlCenterRole.EventPlanner])
    ];

    private IEnumerable<NavItem> VisibleItems =>
        AuthState.CurrentUser is null
            ? []
            : Items.Where(item => item.Roles.Contains(AuthState.CurrentUser.Role));
}
