@inject MockAuthState AuthState
@inject LanguageState Language
@inject NavigationManager NavigationManager

<MudAppBar Elevation="0" Class="topbar">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="OnMenuClicked" />
    <MudSpacer />
    @if (AuthState.CurrentUser is { } user)
    {
        <MudButtonGroup Variant="Variant.Outlined" Class="language-toggle">
            <MudButton Size="Size.Small" Color="@LanguageButtonColor(AppLanguage.English)" OnClick="@(() => Language.SetLanguage(AppLanguage.English))">@Language.T("English")</MudButton>
            <MudButton Size="Size.Small" Color="@LanguageButtonColor(AppLanguage.Farsi)" OnClick="@(() => Language.SetLanguage(AppLanguage.Farsi))">@Language.T("Farsi")</MudButton>
        </MudButtonGroup>
        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Security">
            @user.Role
        </MudChip>
        <MudText Typo="Typo.body2" Class="user-name">@user.DisplayName</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Logout" OnClick="SignOut">
            @Language.T("SignOut")
        </MudButton>
    }
</MudAppBar>

@code {
    [Parameter]
    public EventCallback OnMenuClicked { get; set; }

    private void SignOut()
    {
        AuthState.SignOut();
        NavigationManager.NavigateTo("/login");
    }

    private Color LanguageButtonColor(AppLanguage language) => Language.Current == language ? Color.Primary : Color.Default;
}
