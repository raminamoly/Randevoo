@inject MockAuthState AuthState
@inject NavigationManager NavigationManager

<MudAppBar Elevation="0" Class="topbar">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="OnMenuClicked" />
    <MudSpacer />
    @if (AuthState.CurrentUser is { } user)
    {
        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Security">
            @user.Role
        </MudChip>
        <MudText Typo="Typo.body2" Class="user-name">@user.DisplayName</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Logout" OnClick="SignOut">
            Sign out
        </MudButton>
    }
</MudAppBar>

@code {
    [Parameter]
    public EventCallback OnMenuClicked { get; set; }

    private void SignOut()
    {
        AuthState.SignOut();
        NavigationManager.NavigateTo("/login");
    }
}
