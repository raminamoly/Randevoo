<MudPaper Class="empty-state" Elevation="0">
    <MudIcon Icon="@Icon" Size="Size.Large" />
    <MudText Typo="Typo.h6">@Title</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">@Message</MudText>
</MudPaper>

@code {
    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.Inbox;

    [Parameter]
    public string Title { get; set; } = "Nothing to show";

    [Parameter]
    public string Message { get; set; } = "Mock data will appear here when this workflow is connected.";
}
