@page "/my/dashboard"
@attribute [ControlCenterAuthorize(ControlCenterRole.EventPlanner)]
@using Randevoo.ControlCenter.Services.ApiClients
@inject IDashboardApiClient DashboardClient

<PageHeader Title="My dashboard" Kicker="EventPlanner workspace" Description="Planner-facing operations for events, tickets, settlements, and feedback." />

@if (_metrics is null)
{
    <LoadingState />
}
else
{
    <MudGrid>
        @foreach (var metric in _metrics)
        {
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Label="@metric.Label" Value="@metric.Value" Detail="@metric.Detail" Icon="@metric.Icon" AccentColor="@metric.AccentColor" />
            </MudItem>
        }
    </MudGrid>

    <MudPaper Class="placeholder-panel" Elevation="0">
        <MudText Typo="Typo.h6">Planner checklist</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Mock data keeps this UI decoupled while the WebApi client contracts settle.</MudText>
    </MudPaper>
}

@code {
    private IReadOnlyList<DashboardMetric>? _metrics;

    protected override async Task OnInitializedAsync()
    {
        _metrics = await DashboardClient.GetDashboardMetricsAsync(ControlCenterRole.EventPlanner);
    }
}
