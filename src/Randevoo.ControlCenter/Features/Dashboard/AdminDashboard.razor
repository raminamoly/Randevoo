@page "/dashboard"
@attribute [ControlCenterAuthorize(ControlCenterRole.Admin)]
@using Randevoo.ControlCenter.Services.ApiClients
@inject IDashboardApiClient DashboardClient

<PageHeader Title="Admin dashboard" Kicker="Admin operations" Description="Platform-level cockpit for events, planners, balances, and safety workflows." />

@if (_metrics is null)
{
    <LoadingState />
}
else
{
    <MudGrid>
        @foreach (var metric in _metrics)
        {
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Label="@metric.Label" Value="@metric.Value" Detail="@metric.Detail" Icon="@metric.Icon" AccentColor="@metric.AccentColor" />
            </MudItem>
        }
    </MudGrid>

    <MudPaper Class="placeholder-panel" Elevation="0">
        <MudText Typo="Typo.h6">Operational queue</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">This first version uses mock API clients. Backend integration will flow through typed services only.</MudText>
    </MudPaper>
}

@code {
    private IReadOnlyList<DashboardMetric>? _metrics;

    protected override async Task OnInitializedAsync()
    {
        _metrics = await DashboardClient.GetDashboardMetricsAsync(ControlCenterRole.Admin);
    }
}
