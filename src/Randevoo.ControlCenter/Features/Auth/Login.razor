@page "/login"
@using Randevoo.ControlCenter.Services.ApiClients
@inject IControlCenterAuthClient AuthClient
@inject MockAuthState AuthState
@inject LanguageState Language
@inject NavigationManager NavigationManager

<div class="login-page" dir="@Language.Direction" lang="@Language.LanguageCode">
    <MudPaper Class="login-panel" Elevation="0">
        <MudButtonGroup Variant="Variant.Outlined" Class="language-toggle">
            <MudButton Size="Size.Small" Color="@LanguageButtonColor(AppLanguage.English)" OnClick="@(() => Language.SetLanguage(AppLanguage.English))">@Language.T("English")</MudButton>
            <MudButton Size="Size.Small" Color="@LanguageButtonColor(AppLanguage.Farsi)" OnClick="@(() => Language.SetLanguage(AppLanguage.Farsi))">@Language.T("Farsi")</MudButton>
        </MudButtonGroup>
        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h4">@Language.T("Brand") @Language.T("ControlCenter")</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@Language.T("MockPlan")</MudText>

        @if (_step == 1)
        {
            <MudTextField @bind-Value="_mobileNumber" Label="Mobile number" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick="Continue" Disabled="@string.IsNullOrWhiteSpace(_mobileNumber)">
                Continue
            </MudButton>
        }
        else
        {
            <MudTextField @bind-Value="_smsCode" Label="SMS code" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudRadioGroup @bind-Value="_role">
                <MudRadio Value="ControlCenterRole.Admin" Color="Color.Primary">Admin</MudRadio>
                <MudRadio Value="ControlCenterRole.EventPlanner" Color="Color.Primary">EventPlanner</MudRadio>
            </MudRadioGroup>
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick="SignInAsync" Disabled="@string.IsNullOrWhiteSpace(_smsCode)">
                Sign in
            </MudButton>
            <MudButton FullWidth="true" Variant="Variant.Text" OnClick="@(() => _step = 1)">Back</MudButton>
        }
    </MudPaper>
</div>

@code {
    private int _step = 1;
    private string _mobileNumber = "09120000000";
    private string _smsCode = "123456";
    private ControlCenterRole _role = ControlCenterRole.Admin;

    protected override void OnInitialized()
    {
        if (AuthState.CurrentUser is { Role: ControlCenterRole.Admin })
        {
            NavigationManager.NavigateTo("/dashboard");
        }
        else if (AuthState.CurrentUser is { Role: ControlCenterRole.EventPlanner })
        {
            NavigationManager.NavigateTo("/my/dashboard");
        }
    }

    private void Continue() => _step = 2;

    private async Task SignInAsync()
    {
        var user = await AuthClient.VerifySmsCodeAsync(new LoginRequest(_mobileNumber, _smsCode, _role));
        AuthState.SignIn(user);
        NavigationManager.NavigateTo(user.Role == ControlCenterRole.Admin ? "/dashboard" : "/my/dashboard");
    }

    private Color LanguageButtonColor(AppLanguage language) => Language.Current == language ? Color.Primary : Color.Default;
}
