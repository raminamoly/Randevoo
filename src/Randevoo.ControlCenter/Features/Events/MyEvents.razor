@page "/my/events"
@attribute [ControlCenterAuthorize(ControlCenterRole.EventPlanner)]
@using Randevoo.ControlCenter.Services.ApiClients
@inject IEventsApiClient EventsClient
@inject LanguageState Language
@inject ISnackbar Snackbar

<PageHeader Title="@Language.T("MyEvents")" Kicker="@Language.T("PlannerWorkspace")" Description="@Language.T("MyEventsDescription")" />

<EventCreateForm Input="_draft" OnSubmit="CreateEventAsync" />

@if (_events is null)
{
    <LoadingState />
}
else if (_events.Count == 0)
{
    <EmptyState Title="@Language.T("NoEvents")" />
}
else
{
    <EventsTable Events="_events" />
}

@code {
    private IReadOnlyList<EventSummary>? _events;
    private EventDraftInput _draft = new();

    protected override async Task OnInitializedAsync()
    {
        _events = await EventsClient.GetEventsAsync(ControlCenterRole.EventPlanner);
    }

    private async Task CreateEventAsync(EventDraftInput input)
    {
        await EventsClient.CreatePlannerEventAsync(input);
        Snackbar.Add(Language.T("EventCreated"), Severity.Success);
        _draft = new();
        _events = await EventsClient.GetEventsAsync(ControlCenterRole.EventPlanner);
    }
}
