@page "/events"
@attribute [ControlCenterAuthorize(ControlCenterRole.Admin)]
@using Randevoo.ControlCenter.Services.ApiClients
@inject IEventsApiClient EventsClient
@inject LanguageState Language
@inject ISnackbar Snackbar

<PageHeader Title="@Language.T("Events")" Kicker="@Language.T("AdminOperations")" Description="@Language.T("EventsDescription")" />

@if (_events is null)
{
    <LoadingState />
}
else if (_events.Count == 0)
{
    <EmptyState Title="@Language.T("NoEvents")" />
}
else
{
    <EventsTable Events="_events" />
}

@code {
    private IReadOnlyList<EventSummary>? _events;

    protected override async Task OnInitializedAsync()
    {
        _events = await EventsClient.GetEventsAsync(ControlCenterRole.Admin);
    }

}
