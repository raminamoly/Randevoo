@page
@model Randevoo.AdminPanel.Pages.Account.ForbiddenModel
@{
    ViewData["Title"] = "دسترسی غیرمجاز";
    ViewData["UseShell"] = false;
}

<section class="auth-card glass-panel auth-card-premium text-center">
    <div class="auth-orb auth-orb-pink"></div>
    <div class="auth-orb auth-orb-blue"></div>
    <img src="~/images/logo.png" alt="رندوو" class="auth-logo mx-auto mb-3" />
    <h1 class="mb-2">دسترسی شما به این بخش مجاز نیست</h1>
    <p class="text-muted mb-4">نقش فعلی شما اجازه ورود به این صفحه را ندارد. از داشبورد مناسب نقش خودتان ادامه دهید.</p>
    <a asp-page="/Dashboard/Index" class="btn btn-primary">بازگشت به داشبورد</a>
</section>
