@page
@model Randevoo.AdminPanel.Pages.Account.LoginModel
@{
    ViewData["Title"] = "ورود";
    ViewData["UseShell"] = false;
}

<section class="auth-card glass-panel auth-card-premium">
    <div class="auth-orb auth-orb-pink"></div>
    <div class="auth-orb auth-orb-blue"></div>
    <div class="auth-brand">
        <img src="~/images/logo.png" alt="راندوو" class="auth-logo" />
        <div>
            <h1>ورود به مرکز کنترل</h1>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-info border-0">@Model.Message</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger border-0">@Model.ErrorMessage</div>
    }

    @if (Model.ShowQuickLogin)
    {
        <form method="post" asp-page-handler="QuickLogin" class="quick-login-panel mb-4">
            <label asp-for="QuickLoginKey" class="form-label">ورود سریع برای تست</label>
            <div class="quick-login-row">
                <select asp-for="QuickLoginKey" class="form-select form-select-lg" asp-items="Model.QuickLoginOptions">
                    <option value="">انتخاب حساب تستی</option>
                </select>
                <button type="submit" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-lightning-charge-fill"></i>
                    ورود سریع
                </button>
            </div>
        </form>
    }

    <form method="post" class="stacked-form">
        <input type="hidden" asp-for="Step" />

        @if (Model.Step == 1)
        {
            <div class="mb-3">
                <label asp-for="Input.Mobile" class="form-label">شماره موبایل</label>
                <input asp-for="Input.Mobile" class="form-control form-control-lg" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" placeholder="09125177721" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Role" class="form-label">نقش ورود</label>
                <select asp-for="Input.Role" class="form-select form-select-lg" asp-items="Model.RoleOptions"></select>
            </div>
            <button type="submit" asp-page-handler="RequestCode" class="btn btn-primary btn-lg w-100">
                دریافت کد تایید
            </button>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">شماره موبایل</label>
                <input asp-for="Input.Mobile" class="form-control form-control-lg" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="Input.VerificationCode" class="form-label">کد پیامک</label>
                <input asp-for="Input.VerificationCode" class="form-control form-control-lg" inputmode="numeric" autocomplete="one-time-code" dir="ltr" placeholder="123456" />
            </div>
            <div class="mb-3">
                <label class="form-label">نقش</label>
                <input class="form-control form-control-lg" value="@DisplayFormatter.Role(Model.Input.Role)" readonly />
            </div>
            <input type="hidden" asp-for="Input.Role" />
            <button type="submit" asp-page-handler="Login" class="btn btn-primary btn-lg w-100">
                ورود به پنل
            </button>
            <button type="submit" asp-page-handler="Back" class="btn btn-link w-100 mt-2">بازگشت و ویرایش اطلاعات</button>
        }
    </form>
</section>
