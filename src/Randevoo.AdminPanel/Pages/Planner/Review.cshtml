@page "{id:long}"
@model Randevoo.AdminPanel.Pages.Planner.ReviewModel
@{
    ViewData["Title"] = "بررسی پروفایل برگزارکننده";
}

<section class="page-header">
    <div>
        <h1>بررسی پروفایل برگزارکننده</h1>
    </div>
    <a asp-page="/Planner/Approvals" class="btn btn-outline-secondary">بازگشت به لیست</a>
</section>

<div class="row g-4">
    <div class="col-lg-7">
        <form method="post" class="glass-panel p-4">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-3"></div>
            <h2 class="section-title mb-3">نسخه نهایی برای انتشار</h2>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.FullName" class="form-label">نام و نام خانوادگی</label>
                    <input asp-for="Input.FullName" class="form-control" />
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.City" class="form-label">شهر فعالیت</label>
                    <input asp-for="Input.City" class="form-control" />
                    <span asp-validation-for="Input.City" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Title" class="form-label">عنوان حرفه ای</label>
                    <input asp-for="Input.Title" class="form-control" />
                    <span asp-validation-for="Input.Title" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.PictureUrl" class="form-label">تصویر</label>
                    <input asp-for="Input.PictureUrl" class="form-control" />
                    <span asp-validation-for="Input.PictureUrl" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Resume" class="form-label">معرفی و تجربه حرفه ای</label>
                    <textarea asp-for="Input.Resume" class="form-control" rows="8"></textarea>
                    <span asp-validation-for="Input.Resume" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.ReviewNote" class="form-label">یادداشت مدیر</label>
                    <textarea asp-for="Input.ReviewNote" class="form-control" rows="3" placeholder="اختیاری"></textarea>
                    <span asp-validation-for="Input.ReviewNote" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 d-flex flex-wrap gap-2">
                <button type="submit" asp-page-handler="Approve" class="btn btn-primary">تایید و انتشار</button>
                @if (Model.Profile.HasPendingChanges)
                {
                    <button type="submit" asp-page-handler="Reject" class="btn btn-outline-danger">رد درخواست</button>
                }
                <a asp-page="/Planner/Details" asp-route-id="@Model.Profile.UserId" class="btn btn-outline-secondary">نمایش عمومی</a>
            </div>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="glass-panel p-4 mb-4">
            <h2 class="section-title mb-3">نسخه منتشرشده</h2>
            <div class="planner-public-header">
                <img src="@(Model.Profile.PictureUrl ?? "/images/logo.png")" alt="@Model.Profile.FullName" class="planner-avatar-lg planner-profile-photo" />
                <div>
                    <div class="fw-semibold">@Model.Profile.FullName</div>
                    <div class="planner-title">@Model.Profile.Title</div>
                    <div class="text-muted small mt-2">@Model.Profile.City</div>
                </div>
            </div>
            <p class="text-muted mt-3 mb-0">@Model.Profile.Resume</p>
        </div>

        <div class="glass-panel p-4">
            <h2 class="section-title mb-3">تغییرات در انتظار تایید</h2>
            <div class="mb-3">
                <span class="status-badge @(Model.Profile.HasPendingChanges ? "status-pending" : "status-approved")">
                    @(Model.Profile.HasPendingChanges ? "در انتظار تایید" : "تغییر تاییدنشده ای وجود ندارد")
                </span>
            </div>
            @if (Model.Profile.HasPendingChanges)
            {
                <div class="planner-public-header">
                    <img src="@(Model.Profile.PendingPictureUrl ?? Model.Profile.PictureUrl ?? "/images/logo.png")" alt="پیش نمایش تغییرات" class="planner-avatar-lg planner-profile-photo" />
                    <div>
                        <div class="fw-semibold">@(Model.Profile.PendingFullName ?? Model.Profile.FullName)</div>
                        <div class="planner-title">@(Model.Profile.PendingTitle ?? Model.Profile.Title)</div>
                        <div class="text-muted small mt-2">@(Model.Profile.PendingCity ?? Model.Profile.City)</div>
                    </div>
                </div>
                <p class="text-muted mt-3 mb-0">@(Model.Profile.PendingResume ?? Model.Profile.Resume)</p>
                @if (Model.Profile.PendingSubmittedAtUtc is not null)
                {
                    <div class="help-tip mt-3">زمان ثبت درخواست: @PersianDateFormatter.Format(Model.Profile.PendingSubmittedAtUtc.Value, Model.IsRtl)</div>
                }
            }
            @if (!string.IsNullOrWhiteSpace(Model.Profile.PendingReviewNote))
            {
                <div class="alert alert-info border-0 mt-3 mb-0">@Model.Profile.PendingReviewNote</div>
            }
        </div>
    </div>
</div>
