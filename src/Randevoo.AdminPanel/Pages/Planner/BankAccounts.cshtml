@page "{plannerUserId:long?}"
@model Randevoo.AdminPanel.Pages.Planner.BankAccountsModel
@using Randevoo.Domain.Enums
@{
    ViewData["Title"] = "حساب های بانکی برگزارکننده";
}

<section class="page-header">
    <div>
        <h1>حساب های بانکی برگزارکننده</h1>
    </div>
    <a asp-page="/Planner/Details" asp-route-id="@Model.PlannerUserId" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right"></i>بازگشت به پروفایل
    </a>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success border-0 mb-4">@Model.StatusMessage</div>
}

<div class="row g-4">
    <div class="col-xl-5">
        <form method="post" asp-page-handler="Save" asp-route-plannerUserId="@Model.PlannerUserId" class="glass-panel p-4 stacked-form">
            <input type="hidden" asp-for="Input.Id" />
            <h2 class="section-title">@(Model.Input.Id is null ? "ثبت حساب بانکی" : "ویرایش حساب بانکی")</h2>
            <div>
                <label asp-for="Input.CurrencyCode" class="form-label">ارز حساب بانکی</label>
                <select asp-for="Input.CurrencyCode" class="form-select" asp-items="Model.CurrencyOptions" data-bank-account-currency="true"></select>
                <div class="form-text">این ارز برای تسویه یا پرداخت مستقیم همان حساب استفاده می‌شود.</div>
            </div>
            <div>
                <label asp-for="Input.AccountHolderName" class="form-label">نام صاحب حساب</label>
                <input asp-for="Input.AccountHolderName" class="form-control" placeholder="نام صاحب حساب" />
                <span asp-validation-for="Input.AccountHolderName" class="text-danger small"></span>
            </div>
            <div data-bank-account-fields="irr">
                <div>
                    <label asp-for="Input.CardNumber" class="form-label">شماره کارت</label>
                    <input asp-for="Input.CardNumber" class="form-control" dir="ltr" placeholder="603799..." />
                    <span asp-validation-for="Input.CardNumber" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Input.Iban" class="form-label">شماره شبا</label>
                    <input asp-for="Input.Iban" class="form-control" dir="ltr" placeholder="IR..." />
                    <span asp-validation-for="Input.Iban" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Input.BankName" class="form-label">بانک</label>
                    <input asp-for="Input.BankName" class="form-control" placeholder="نام بانک" />
                    <span asp-validation-for="Input.BankName" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Input.AccountNumber" class="form-label">شماره حساب</label>
                    <input asp-for="Input.AccountNumber" class="form-control" dir="ltr" placeholder="اختیاری" />
                    <span asp-validation-for="Input.AccountNumber" class="text-danger small"></span>
                </div>
            </div>
            <div data-bank-account-fields="foreign">
                <div>
                    <label asp-for="Input.PayoutMethod" class="form-label">روش دریافت وجه</label>
                    <select asp-for="Input.PayoutMethod" class="form-select">
                        <option value="@PlannerPayoutMethod.IbanSwift">IBAN / SWIFT</option>
                        <option value="@PlannerPayoutMethod.BankTransfer">Bank Transfer</option>
                        <option value="@PlannerPayoutMethod.PayPal">PayPal</option>
                        <option value="@PlannerPayoutMethod.Wise">Wise</option>
                        <option value="@PlannerPayoutMethod.StripeConnect">Stripe Connect</option>
                        <option value="@PlannerPayoutMethod.Other">سایر</option>
                    </select>
                </div>
                <div>
                    <label asp-for="Input.Country" class="form-label">کشور حساب</label>
                    <input asp-for="Input.Country" class="form-control" placeholder="مثلاً Canada" />
                    <span asp-validation-for="Input.Country" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Input.BankName" class="form-label">نام بانک</label>
                    <input asp-for="Input.BankName" class="form-control" placeholder="نام بانک" />
                    <span asp-validation-for="Input.BankName" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Input.Iban" class="form-label">IBAN</label>
                    <input asp-for="Input.Iban" class="form-control" dir="ltr" placeholder="اختیاری" />
                    <span asp-validation-for="Input.Iban" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Input.SwiftCode" class="form-label">SWIFT / BIC</label>
                    <input asp-for="Input.SwiftCode" class="form-control" dir="ltr" placeholder="اختیاری" />
                    <span asp-validation-for="Input.SwiftCode" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Input.AccountIdentifier" class="form-label">شناسه حساب / ایمیل پرداخت</label>
                    <input asp-for="Input.AccountIdentifier" class="form-control" dir="ltr" placeholder="PayPal, Wise, Stripe ID یا شماره حساب" />
                    <span asp-validation-for="Input.AccountIdentifier" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Input.PublicPaymentInstructions" class="form-label">توضیحات پرداخت برای شرکت‌کننده/پلتفرم</label>
                    <textarea asp-for="Input.PublicPaymentInstructions" class="form-control" rows="4" placeholder="اطلاعات لازم برای واریز یا پرداخت دستی را وارد کنید."></textarea>
                    <span asp-validation-for="Input.PublicPaymentInstructions" class="text-danger small"></span>
                </div>
            </div>
            <div class="form-check form-switch">
                <input asp-for="Input.IsActive" class="form-check-input" />
                <label asp-for="Input.IsActive" class="form-check-label">فعال</label>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i>@(Model.Input.Id is null ? "ذخیره حساب" : "ذخیره ویرایش")</button>
            @if (Model.Input.Id is not null)
            {
                <a asp-page="/Planner/BankAccounts" asp-route-plannerUserId="@Model.PlannerUserId" class="btn btn-outline-secondary">
                    <i class="bi bi-plus-circle"></i>ثبت حساب جدید
                </a>
            }
        </form>
    </div>

    <div class="col-xl-7">
        <div class="glass-panel p-4">
            <h2 class="section-title">حساب های ثبت شده</h2>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>بانک</th>
                            <th>ارز/روش</th>
                            <th>اطلاعات پرداخت</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in Model.Accounts)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@(account.BankName ?? "بدون بانک")</div>
                                    <div class="text-muted small">@account.AccountHolderName</div>
                                </td>
                                <td>
                                    <div dir="ltr">@account.CurrencyCode</div>
                                    <div class="text-muted small">@DisplayFormatter.PayoutMethod(account.PayoutMethod)</div>
                                </td>
                                <td class="table-wrap-cell">
                                    @if (account.CurrencyCode == "IRR")
                                    {
                                        <div dir="ltr">@(account.CardNumber ?? "-")</div>
                                        <div dir="ltr" class="text-muted small">@(account.Iban ?? "-")</div>
                                    }
                                    else
                                    {
                                        <div dir="ltr">@(account.AccountIdentifier ?? account.Iban ?? account.SwiftCode ?? "-")</div>
                                        <div class="text-muted small">@(account.Country ?? account.PublicPaymentInstructions ?? "بدون توضیحات")</div>
                                    }
                                </td>
                                <td><span class="status-badge @(account.IsActive ? "status-approved" : "status-closed")">@(account.IsActive ? "فعال" : "غیرفعال")</span></td>
                                <td class="table-action-cell">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle table-action-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            عملیات
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end action-menu shadow-sm border-0">
                                            <a asp-page="/Planner/BankAccounts"
                                               asp-route-plannerUserId="@Model.PlannerUserId"
                                               asp-route-EditAccountId="@account.Id"
                                               class="dropdown-item">
                                                <i class="bi bi-pencil-square"></i>ویرایش
                                            </a>
                                            <div class="dropdown-divider"></div>
                                            <form method="post" asp-page-handler="Toggle" asp-route-plannerUserId="@Model.PlannerUserId">
                                                <input type="hidden" name="bankAccountId" value="@account.Id" />
                                                <input type="hidden" name="isActive" value="@(!account.IsActive)" />
                                                <button type="submit" class="dropdown-item">
                                                    <i class="bi @(account.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>@(account.IsActive ? "غیرفعال کردن" : "فعال کردن")
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Accounts.Count == 0)
            {
                <div class="empty-state">هنوز حساب بانکی ثبت نشده است.</div>
            }
        </div>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />
<script>
    (function () {
        const currency = document.querySelector("[data-bank-account-currency='true']");
        const irrFields = document.querySelector("[data-bank-account-fields='irr']");
        const foreignFields = document.querySelector("[data-bank-account-fields='foreign']");
        if (!currency || !irrFields || !foreignFields) {
            return;
        }

        const sync = function () {
            const isIrr = (currency.value || "").toUpperCase() === "IRR";
            irrFields.classList.toggle("d-none", !isIrr);
            foreignFields.classList.toggle("d-none", isIrr);
            irrFields.querySelectorAll("input, select, textarea").forEach(function (input) {
                input.disabled = !isIrr;
            });
            foreignFields.querySelectorAll("input, select, textarea").forEach(function (input) {
                input.disabled = isIrr;
            });
        };

        currency.addEventListener("change", sync);
        sync();
    })();
</script>
