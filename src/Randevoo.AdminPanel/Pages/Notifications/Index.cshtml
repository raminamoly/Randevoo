@page
@model Randevoo.AdminPanel.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "پیام‌ها";
}

<div class="page-heading">
    <div>
        <h1>پیام‌ها</h1>
        <p>اعلان‌ها و پیام‌های سیستمی جدا از تیکت‌های پشتیبانی.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Notifications/Create" class="btn btn-primary"><i class="bi bi-send"></i>ارسال پیام</a>
        <a asp-page="/Notifications/Approvals" class="btn btn-outline-secondary"><i class="bi bi-shield-check"></i>صف تایید</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}

<div class="content-card">
    <form method="get" class="notification-filter-bar">
        <div>
            <label asp-for="Filter.Search" class="form-label">جستجو</label>
            <input asp-for="Filter.Search" class="form-control" placeholder="عنوان یا متن پیام" />
        </div>
        <div>
            <label asp-for="Filter.ReadState" class="form-label">وضعیت</label>
            <select asp-for="Filter.ReadState" class="form-select">
                <option value="All">همه</option>
                <option value="Unread">خوانده‌نشده</option>
                <option value="Read">خوانده‌شده</option>
            </select>
        </div>
        <div>
            <label asp-for="Filter.Type" class="form-label">نوع پیام</label>
            <select asp-for="Filter.Type" class="form-select" asp-items="Model.MessageTypeItems">
                <option value="">همه</option>
            </select>
        </div>
        <div>
            <label asp-for="Filter.Priority" class="form-label">اهمیت</label>
            <select asp-for="Filter.Priority" class="form-select" asp-items="Model.PriorityItems">
                <option value="">همه</option>
            </select>
        </div>
        <div>
            <label asp-for="Filter.EventId" class="form-label">رویداد</label>
            <select asp-for="Filter.EventId" class="form-select searchable-select" asp-items="Model.EventItems">
                <option value="">همه</option>
            </select>
        </div>
        <div>
            <label asp-for="Filter.SortBy" class="form-label">مرتب‌سازی</label>
            <select asp-for="Filter.SortBy" class="form-select">
                <option value="created_desc">جدیدترین</option>
                <option value="created_asc">قدیمی‌ترین</option>
                <option value="priority_desc">اهمیت بیشتر</option>
                <option value="unread_first">خوانده‌نشده اول</option>
            </select>
        </div>
        <input type="hidden" asp-for="Filter.Page" value="1" />
        <input type="hidden" asp-for="Filter.PageSize" />
        <div class="notification-filter-actions">
            <button class="btn btn-primary" type="submit"><i class="bi bi-funnel"></i>اعمال</button>
            <a asp-page="/Notifications/Index" class="btn btn-outline-secondary">پاک کردن</a>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="text-muted small">نمایش @Model.Notifications.Count پیام از @Model.Result.TotalCount پیام</div>
        <form method="post">
            <button asp-page-handler="ReadAll" class="btn btn-sm btn-outline-secondary" type="submit">خواندن همه</button>
        </form>
    </div>
    <div class="notification-grid">
        @foreach (var item in Model.Notifications)
        {
            <article class="notification-row @(item.ReadAtUtc is null ? "unread" : string.Empty)">
                <div>
                    <div class="notification-row-head">
                        <span class="fw-semibold">@item.Title</span>
                        <span class="notification-pill">@item.TypeLabel</span>
                        <span class="notification-pill priority">@item.PriorityLabel</span>
                        @if (item.ReadAtUtc is null)
                        {
                            <span class="notification-pill unread-pill">خوانده‌نشده</span>
                        }
                    </div>
                    <div class="text-muted small">
                        @item.CreatedByName - @item.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                        @if (!string.IsNullOrWhiteSpace(item.EventTitle))
                        {
                            <span> - @item.EventTitle</span>
                        }
                    </div>
                    <p class="mb-0 mt-2">@item.Body</p>
                </div>
                @if (item.ReadAtUtc is null)
                {
                    <form method="post">
                        <button asp-page-handler="Read" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" type="submit">خواندم</button>
                    </form>
                }
            </article>
        }
    </div>
    @if (Model.Notifications.Count == 0)
    {
        <div class="empty-state">پیامی برای نمایش وجود ندارد.</div>
    }
    @if (Model.Result.TotalPages > 1)
    {
        <nav class="notification-pagination" aria-label="صفحه‌بندی پیام‌ها">
            <a class="btn btn-sm btn-outline-secondary @(Model.Result.Page <= 1 ? "disabled" : "")"
               href="?Filter.Page=@(Model.Result.Page - 1)&Filter.PageSize=@Model.Result.PageSize&Filter.Search=@Uri.EscapeDataString(Model.Filter.Search ?? "")&Filter.ReadState=@Model.Filter.ReadState&Filter.Type=@Model.Filter.Type&Filter.Priority=@Model.Filter.Priority&Filter.EventId=@Model.Filter.EventId&Filter.SortBy=@Model.Filter.SortBy">قبلی</a>
            <span>صفحه @Model.Result.Page از @Model.Result.TotalPages</span>
            <a class="btn btn-sm btn-outline-secondary @(Model.Result.Page >= Model.Result.TotalPages ? "disabled" : "")"
               href="?Filter.Page=@(Model.Result.Page + 1)&Filter.PageSize=@Model.Result.PageSize&Filter.Search=@Uri.EscapeDataString(Model.Filter.Search ?? "")&Filter.ReadState=@Model.Filter.ReadState&Filter.Type=@Model.Filter.Type&Filter.Priority=@Model.Filter.Priority&Filter.EventId=@Model.Filter.EventId&Filter.SortBy=@Model.Filter.SortBy">بعدی</a>
        </nav>
    }
</div>
