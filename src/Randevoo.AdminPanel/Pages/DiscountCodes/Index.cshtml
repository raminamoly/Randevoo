@page "{id?}"
@model Randevoo.AdminPanel.Pages.DiscountCodes.IndexModel
@{
    ViewData["Title"] = "کدهای تخفیف";
}

<section class="page-header">
    <div>
        <h1>کدهای تخفیف</h1>
        <p>تعریف، ویرایش و مدیریت کدهای تخفیف مخصوص هر رویداد با محدودیت جنسیت، بازه زمانی و سقف مصرف.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info border-0 mb-4">@Model.StatusMessage</div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <form method="post" class="glass-panel p-4 sticky-panel">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-3"></div>

            <h2 class="section-title">@((Model.IsEditing) ? "ویرایش کد تخفیف" : "ایجاد کد تخفیف")</h2>

            <div class="mb-3">
                <label asp-for="Input.DatingEventId" class="form-label">رویداد</label>
                <select asp-for="Input.DatingEventId" class="form-select" asp-items="Model.EventOptions">
                    <option value="">همه رویدادها</option>
                </select>
                <span asp-validation-for="Input.DatingEventId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Code" class="form-label">کد تخفیف</label>
                <input asp-for="Input.Code" class="form-control" dir="ltr" placeholder="WELCOME20" />
                <span asp-validation-for="Input.Code" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label">عنوان</label>
                <input asp-for="Input.Title" class="form-control" placeholder="مثلاً تخفیف افتتاحیه" />
            </div>

            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label">توضیحات</label>
                <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="row g-3">
                <input type="hidden" asp-for="Input.Value" data-discount-value-hidden="true" />
                <div class="col-md-6">
                    <label asp-for="Input.GenderScope" class="form-label">محدودیت جنسیت</label>
                    <select asp-for="Input.GenderScope" class="form-select" asp-items="Model.GenderOptions"></select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">نوع تخفیف</label>
                    <div class="choice-group" data-discount-type-group="true">
                        <input class="btn-check" type="radio" asp-for="Input.DiscountType" id="discountTypeFixed" value="@Randevoo.Domain.Enums.EventDiscountType.FixedAmount" />
                        <label class="btn btn-outline-primary" for="discountTypeFixed">مبلغ</label>
                        <input class="btn-check" type="radio" asp-for="Input.DiscountType" id="discountTypePercent" value="@Randevoo.Domain.Enums.EventDiscountType.Percentage" />
                        <label class="btn btn-outline-primary" for="discountTypePercent">درصد</label>
                    </div>
                </div>
                <div class="col-md-6" data-discount-value-panel="fixed">
                    <label for="FixedDiscountValue" class="form-label">مبلغ تخفیف (ریال)</label>
                    <input id="FixedDiscountValue" class="form-control money-input" type="text" inputmode="numeric" autocomplete="off" value="@Model.Input.Value.ToString("0.##")" data-discount-value-source="fixed" />
                    <span class="field-unit">ریال</span>
                    <span asp-validation-for="Input.Value" class="text-danger small"></span>
                </div>
                <div class="col-md-6" data-discount-value-panel="percentage">
                    <label for="PercentDiscountValue" class="form-label">درصد تخفیف</label>
                    <input id="PercentDiscountValue" class="form-control percent-input" type="number" step="0.01" min="1" max="100" value="@Model.Input.Value.ToString("0.##")" data-discount-value-source="percentage" />
                    <span asp-validation-for="Input.Value" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.MaxUsageCount" class="form-label">سقف استفاده</label>
                    <input asp-for="Input.MaxUsageCount" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Input.MaxUsageCount" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="StartsAtText" class="form-label">شروع اعتبار</label>
                    <input asp-for="StartsAtText" class="form-control jalali-date-time-picker" placeholder="۱۴۰۵/۰۳/۱۵ ۱۸:۳۰" autocomplete="off" />
                </div>
                <div class="col-md-6">
                    <label asp-for="EndsAtText" class="form-label">پایان اعتبار</label>
                    <input asp-for="EndsAtText" class="form-control jalali-date-time-picker" placeholder="۱۴۰۵/۰۴/۱۵ ۲۳:۵۹" autocomplete="off" />
                    <span asp-validation-for="Input.EndsAtUtc" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-check form-switch my-3">
                <input asp-for="Input.IsActive" class="form-check-input" />
                <label asp-for="Input.IsActive" class="form-check-label">فعال</label>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">ذخیره کد تخفیف</button>
                @if (Model.IsEditing)
                {
                    <a asp-page="/DiscountCodes/Index" class="btn btn-outline-secondary">ثبت کد جدید</a>
                }
            </div>
        </form>
    </div>

    <div class="col-lg-8">
        <div class="glass-panel p-4 mb-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">جستجو</label>
                    <input asp-for="Search" class="form-control" placeholder="کد، عنوان یا نام رویداد" />
                </div>
                <div class="col-md-5">
                    <label asp-for="EventId" class="form-label">رویداد</label>
                    <select asp-for="EventId" class="form-select" asp-items="Model.EventFilterOptions">
                        <option value="">همه رویدادها</option>
                    </select>
                </div>
                <div class="col-md-3 d-grid">
                    <button type="submit" class="btn btn-outline-primary">اعمال فیلتر</button>
                </div>
            </form>
        </div>

        <div class="glass-panel p-4">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>کد</th>
                            <th>رویداد</th>
                            <th>نوع</th>
                            <th>جنسیت</th>
                            <th>بازه اعتبار</th>
                            <th>مصرف</th>
                            <th>وضعیت</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DiscountCodes.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">هنوز کد تخفیفی ثبت نشده است.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.DiscountCodes)
                            {
                                var statusClass = item.IsActive && !item.IsExpired ? "status-approved" : item.IsExpired ? "status-closed" : "status-rejected";
                                var statusText = item.IsActive && !item.IsExpired ? "فعال" : item.IsExpired ? "منقضی" : "غیرفعال";
                                <tr>
                                    <td>
                                        <div class="fw-semibold" dir="ltr">@item.Code</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Title))
                                        {
                                            <div class="text-muted small">@item.Title</div>
                                        }
                                    </td>
                                    <td class="table-wrap-cell">@item.EventTitle</td>
                                    <td>
                                        @if (item.DiscountType == Randevoo.Domain.Enums.EventDiscountType.Percentage)
                                        {
                                            <span>@DisplayFormatter.ToPersianDigits(item.Value.ToString("0.##"))%</span>
                                        }
                                        else
                                        {
                                            <span>@DisplayFormatter.Money(item.Value, Model.IsRtl)</span>
                                        }
                                    </td>
                                    <td>
                                        @(item.GenderScope switch
                                        {
                                            Randevoo.Domain.Enums.EventDiscountGenderScope.Male => "فقط آقایان",
                                            Randevoo.Domain.Enums.EventDiscountGenderScope.Female => "فقط خانم ها",
                                            _ => "همه"
                                        })
                                    </td>
                                    <td>
                                        <div>@PersianDateFormatter.Format(item.StartsAtUtc, Model.IsRtl)</div>
                                        <div class="text-muted small">تا @PersianDateFormatter.Format(item.EndsAtUtc, Model.IsRtl)</div>
                                    </td>
                                    <td>@DisplayFormatter.Count(item.UsedCount) / @DisplayFormatter.Count(item.MaxUsageCount)</td>
                                    <td><span class="status-badge @statusClass">@statusText</span></td>
                                    <td class="text-end table-action-cell">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle table-action-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                عملیات
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-end action-menu shadow-sm border-0">
                                                <a asp-page="/DiscountCodes/Index" asp-route-id="@item.Id" class="dropdown-item">
                                                    <i class="bi bi-pencil-square"></i>ویرایش
                                                </a>
                                                <a asp-page="/DiscountCodes/Index" asp-route-usageId="@item.Id" asp-route-eventId="@Model.EventId" asp-route-search="@Model.Search" class="dropdown-item">
                                                    <i class="bi bi-people"></i>خریداران استفاده کننده
                                                </a>
                                                <form method="post" asp-page-handler="Toggle">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="isActive" value="@((!item.IsActive).ToString().ToLowerInvariant())" />
                                                    <button class="dropdown-item" type="submit">
                                                        <i class="bi bi-toggle-@(item.IsActive ? "off" : "on")"></i>@(item.IsActive ? "غیرفعال سازی" : "فعال سازی")
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (Model.UsageDiscountCode is not null)
{
    <div class="modal fade show usage-modal-shell" tabindex="-1" role="dialog" aria-modal="true" style="display:block;">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title h5">خریداران کد @Model.UsageDiscountCode.Code</h2>
                        <div class="text-muted small">@Model.UsageDiscountCode.EventTitle</div>
                    </div>
                    <a asp-page="/DiscountCodes/Index" asp-route-eventId="@Model.EventId" asp-route-search="@Model.Search" class="btn-close" aria-label="بستن"></a>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>خریدار</th>
                                    <th>رویداد</th>
                                    <th>جنسیت</th>
                                    <th>زمان خرید</th>
                                    <th>قیمت اصلی</th>
                                    <th>تخفیف</th>
                                    <th>پرداخت نهایی</th>
                                    <th>وضعیت</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.UsageItems.Count == 0)
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">هنوز خریدی با این کد ثبت نشده است.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var usage in Model.UsageItems)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@usage.BuyerName</div>
                                                <div class="text-muted small" dir="ltr">@usage.BuyerMobile</div>
                                            </td>
                                            <td class="table-wrap-cell">@usage.EventTitle</td>
                                            <td>@(usage.BuyerGender == Randevoo.Domain.Enums.Gender.Male ? "آقا" : usage.BuyerGender == Randevoo.Domain.Enums.Gender.Female ? "خانم" : "نامشخص")</td>
                                            <td>@PersianDateFormatter.FormatDateTime(usage.PurchasedAtUtc, Model.IsRtl)</td>
                                            <td>@DisplayFormatter.Money(usage.OriginalPrice, Model.IsRtl)</td>
                                            <td>@DisplayFormatter.Money(usage.DiscountAmount, Model.IsRtl)</td>
                                            <td>@DisplayFormatter.Money(usage.FinalPaidAmount, Model.IsRtl)</td>
                                            <td>@(usage.IsRefunded || usage.IsRemoved ? "برگشت خورده" : "موفق")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<partial name="_ValidationScriptsPartial" />
