@page
@model ErrorModel
@{
    ViewData["Title"] = "خطا";
}

<section class="glass-panel p-4 p-lg-5">
    <h1 class="text-danger">خطا</h1>
    <h2 class="text-danger h4 mb-4">هنگام پردازش درخواست شما مشکلی رخ داد.</h2>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>شناسه درخواست:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <h3 class="h5 mt-4">حالت توسعه</h3>
    <p>
        در حالت <strong>Development</strong> جزئیات بیشتری از خطا نمایش داده می شود تا بررسی و رفع آن ساده تر باشد.
    </p>
    <p class="mb-0">
        برای محیط واقعی بهتر است این حالت غیرفعال باشد تا جزئیات فنی و اطلاعات حساس به شرکت‌کننده نمایش داده نشود.
    </p>
</section>
