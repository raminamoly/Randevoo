@page "{id:long}"
@model Randevoo.AdminPanel.Pages.Events.DetailsModel
@{
    ViewData["Title"] = "پروفایل رویداد";
}

<section class="page-header">
    <div>
        <h1>@Model.Event.DisplayTitle</h1>
        @if (Model.Event.ActiveDraft.Tags.Count > 0)
        {
            <div class="event-chip-list mt-3">
                @foreach (var tag in Model.Event.ActiveDraft.Tags)
                {
                    <span class="event-chip">@tag</span>
                }
            </div>
        }
    </div>
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle action-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            عملیات صفحه
        </button>
        <div class="dropdown-menu dropdown-menu-end action-menu shadow-sm border-0">
            <a asp-page="/Public/Event" asp-route-id="@Model.Event.Id" class="dropdown-item">
                <i class="bi bi-box-arrow-up-left"></i>نمایش عمومی
            </a>
            <a asp-page="/Events/Edit" asp-route-id="@Model.Event.Id" class="dropdown-item">
                <i class="bi bi-pencil-square"></i>ویرایش رویداد
            </a>
            <a asp-page="/Participants/Index" asp-route-EventId="@Model.Event.Id" class="dropdown-item">
                <i class="bi bi-people"></i>فهرست شرکت‌کنندگان
            </a>
            <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#eventStatusTransitionModal-@Model.Event.Id">
                <i class="bi bi-arrow-repeat"></i>تغییر وضعیت رویداد
            </button>
            <a asp-page="/Events/My" class="dropdown-item">
                <i class="bi bi-arrow-right"></i>بازگشت به لیست
            </a>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success border-0 mb-4">@Model.StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger border-0 mb-4">@Model.ErrorMessage</div>
}

<section class="event-details-actionbar glass-panel">
    <div class="event-details-status">
        <span class="status-badge @Model.OperationalStatusClass">@DisplayFormatter.OperationalStatus(Model.Event.OperationalStatus)</span>
        <span class="status-badge @Model.ProfileStatusClass">@DisplayFormatter.ProfileStatus(Model.Event.ApprovalStatus)</span>
        <div>
            <div class="fw-semibold">@Model.Event.PlannerName</div>
            <div class="text-muted small">آخرین به روزرسانی: @PersianDateFormatter.Format(Model.Event.UpdatedAtUtc, Model.IsRtl)</div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Event.AdminReviewNote))
        {
            <div class="alert alert-info border-0 mb-0">@Model.Event.AdminReviewNote</div>
        }
    </div>

    <div class="event-details-actions">
        <button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#eventProfileReviewHistoryModal-@Model.Event.Id">
            <i class="bi bi-clock-history"></i>بررسی‌های مدیر
        </button>
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#eventStatusTransitionModal-@Model.Event.Id">
            <i class="bi bi-arrow-repeat"></i>تغییر وضعیت رویداد
        </button>
        <a asp-page="/Events/Edit" asp-route-id="@Model.Event.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil-square"></i>ویرایش رویداد</a>
        <a asp-page="/Public/Event" asp-route-id="@Model.Event.Id" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-up-left"></i>نمایش عمومی</a>
    </div>
</section>

@if (Model.IsAdmin && Model.Event.ApprovalStatus == Randevoo.Domain.Enums.EventApprovalStatus.PendingReview)
{
    <section class="glass-panel p-4 mb-4">
        <div class="form-section-head">
            <h2 class="section-title mb-0">بررسی پروفایل رویداد</h2>
            <p class="text-muted small mb-0">این بخش فقط برای تایید یا بازگرداندن اطلاعات پروفایل رویداد است و فروش را باز نمی‌کند.</p>
        </div>
        <div class="row g-3">
            <div class="col-lg-6">
                <form method="post" asp-page-handler="ApproveProfile" class="admin-action-card h-100">
                    <input type="hidden" name="id" value="@Model.Event.Id" />
                    <div class="fw-semibold mb-2">تایید پروفایل رویداد</div>
                    <p class="text-muted small mb-3">با تایید، پروفایل رویداد آماده مدیریت عملیاتی می‌شود. فروش همچنان بسته می‌ماند.</p>
                    <label class="form-label">یادداشت مدیر</label>
                    <textarea name="note" class="form-control" rows="2" placeholder="اختیاری"></textarea>
                    <button class="btn btn-success mt-3" type="submit">تایید پروفایل</button>
                </form>
            </div>
            <div class="col-lg-6">
                <form method="post" asp-page-handler="RejectProfile" class="admin-action-card h-100">
                    <input type="hidden" name="id" value="@Model.Event.Id" />
                    <div class="fw-semibold mb-2">رد و بازگردانی برای اصلاح</div>
                    <p class="text-muted small mb-3">توضیح مدیر برای برگزارکننده نمایش داده می‌شود و پروفایل به پیش‌نویس برمی‌گردد.</p>
                    <label class="form-label">توضیح مدیر</label>
                    <textarea name="note" class="form-control" rows="2" required></textarea>
                    <button class="btn btn-outline-danger mt-3" type="submit">رد پروفایل</button>
                </form>
            </div>
        </div>
    </section>
}

<section class="glass-panel p-4 mb-4">
    <partial name="_EventImageSlider" model="Model.EventImageCarousel" />
</section>

<section class="glass-panel p-4 mb-4">
    <h2 class="section-title">چکیده رویداد</h2>
    <div class="row g-3">
        <div class="col-md-3"><div class="detail-block"><span>نحوه برگزاری</span><strong>@Model.Event.ActiveDraft.EventModeName</strong></div></div>
        <div class="col-md-3"><div class="detail-block"><span>نوع رویداد</span><strong>@DisplayFormatter.EventTypeLabel(Model.Event.ActiveDraft.EventTypeName)</strong></div></div>
        <div class="col-md-3"><div class="detail-block"><span>شروع</span><strong>@PersianDateFormatter.Format(Model.Event.ActiveDraft.StartAtUtc, Model.IsRtl)</strong></div></div>
        <div class="col-md-3"><div class="detail-block"><span>پایان</span><strong>@PersianDateFormatter.Format(Model.Event.ActiveDraft.EndAtUtc, Model.IsRtl)</strong></div></div>
        <div class="col-md-6">
            <div class="detail-block">
                <span>تگ های رویداد</span>
                <div class="event-chip-list">
                    @foreach (var tag in Model.Event.ActiveDraft.Tags)
                    {
                        <span class="event-chip">@tag</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3"><div class="detail-block"><span>حداقل تحصیلات خرید بلیت</span><strong>@DisplayFormatter.EducationRestriction(Model.Event.ActiveDraft.EducationLevelRestriction)</strong></div></div>
        <div class="col-md-3"><div class="detail-block"><span>سقف لایک</span><strong>@DisplayFormatter.Count(Model.Event.ActiveDraft.LikeLimit)</strong></div></div>
    </div>
</section>

<section class="glass-panel p-4 mb-4">
    <h2 class="section-title">ظرفیت، سن و قیمت</h2>
    <div class="gender-field-grid">
        <article class="gender-field-panel">
            <h3>آقایان</h3>
            <div class="row g-3">
                <div class="col-md-4"><div class="detail-block"><span>بازه سنی</span><strong>@Model.Event.ActiveDraft.AgeRangeForMale</strong></div></div>
                <div class="col-md-4"><div class="detail-block"><span>ظرفیت</span><strong>@DisplayFormatter.Count(Model.Event.ActiveDraft.CapacityMale)</strong></div></div>
                <div class="col-md-4"><div class="detail-block"><span>قیمت بلیت</span><strong>@DisplayFormatter.TicketMoney(Model.Event.ActiveDraft.MaleTicketPrice, Model.Event.ActiveDraft.MaleTicketCurrencyCode, Model.IsRtl)</strong></div></div>
            </div>
        </article>
        <article class="gender-field-panel">
            <h3>خانم ها</h3>
            <div class="row g-3">
                <div class="col-md-4"><div class="detail-block"><span>بازه سنی</span><strong>@Model.Event.ActiveDraft.AgeRangeForFemale</strong></div></div>
                <div class="col-md-4"><div class="detail-block"><span>ظرفیت</span><strong>@DisplayFormatter.Count(Model.Event.ActiveDraft.CapacityFemale)</strong></div></div>
                <div class="col-md-4"><div class="detail-block"><span>قیمت بلیت</span><strong>@DisplayFormatter.TicketMoney(Model.Event.ActiveDraft.FemaleTicketPrice, Model.Event.ActiveDraft.FemaleTicketCurrencyCode, Model.IsRtl)</strong></div></div>
            </div>
        </article>
    </div>
</section>

<section class="glass-panel p-4 mb-4">
    <h2 class="section-title">پرداخت و تسویه</h2>
    <div class="row g-3">
        <div class="col-md-4"><div class="detail-block"><span>روش دریافت هزینه</span><strong>@DisplayFormatter.PaymentCollectionMethod(Model.Event.ActiveDraft.PaymentCollectionMethod)</strong></div></div>
        <div class="col-md-4"><div class="detail-block"><span>کمیسیون پلتفرم</span><strong>@DisplayFormatter.Percent(Model.Event.ActiveDraft.OrganizerCommissionPercent)</strong></div></div>
        <div class="col-md-4"><div class="detail-block"><span>اثر مالی</span><strong>@DisplayFormatter.PaymentCollectionSettlementNote(Model.Event.ActiveDraft.PaymentCollectionMethod)</strong></div></div>
        @if (Model.Event.ActiveDraft.PaymentCollectionMethod == Randevoo.Domain.Enums.EventPaymentCollectionMethod.OrganizerManualTransfer && !string.IsNullOrWhiteSpace(Model.Event.ActiveDraft.OrganizerPaymentInstructions))
        {
            <div class="col-12"><div class="detail-block payment-instructions-block"><span>اطلاعات پرداخت برگزارکننده</span><strong>@Model.Event.ActiveDraft.OrganizerPaymentInstructions</strong></div></div>
        }
    </div>
</section>

<section class="glass-panel p-4 mb-4">
    <h2 class="section-title">محل و دسترسی</h2>
    <div class="row g-3">
        @if (Model.Event.ActiveDraft.IsOnline)
        {
            <div class="col-md-4"><div class="detail-block"><span>پلتفرم</span><strong>@Model.Event.ActiveDraft.OnlinePlatformName</strong></div></div>
            <div class="col-md-8"><div class="detail-block"><span>لینک ورود</span><strong dir="ltr">@Model.Event.ActiveDraft.OnlineJoinUrl</strong></div></div>
            @if (!string.IsNullOrWhiteSpace(Model.Event.ActiveDraft.OnlineAccessInstructions))
            {
                <div class="col-12"><div class="detail-block"><span>راهنمای ورود</span><strong>@Model.Event.ActiveDraft.OnlineAccessInstructions</strong></div></div>
            }
        }
        else
        {
            <div class="col-md-4"><div class="detail-block"><span>محل برگزاری</span><strong>@Model.Event.ActiveDraft.VenueName</strong></div></div>
            <div class="col-md-4"><div class="detail-block"><span>شهر و کشور</span><strong>@Model.Event.ActiveDraft.City، @Model.Event.ActiveDraft.Country</strong></div></div>
            <div class="col-md-4"><div class="detail-block"><span>منطقه</span><strong>@Model.Event.ActiveDraft.Region</strong></div></div>
            <div class="col-12"><div class="detail-block"><span>آدرس</span><strong>@Model.Event.ActiveDraft.Address</strong></div></div>
        }
    </div>
</section>

<section class="glass-panel p-4 mb-4">
    <h2 class="section-title">توضیحات رویداد</h2>
    <div class="rich-text-preview">@Html.Raw(Model.Event.ActiveDraft.DescriptionHtml)</div>
</section>

@if (Model.PlannerProfile is not null)
{
    <section class="glass-panel p-4 mb-4 planner-card">
        <div class="d-flex align-items-center gap-3">
            <img src="@Model.PlannerProfile.PictureUrl" alt="@Model.PlannerProfile.FullName" class="planner-avatar" />
            <div>
                <h2 class="section-title mb-1">@Model.PlannerProfile.FullName</h2>
                <div class="planner-title">@Model.PlannerProfile.Title</div>
            </div>
        </div>
        <p class="text-muted mt-3">@Model.PlannerProfile.Resume</p>
        <div class="planner-metrics">
            <div class="detail-block"><span>شهر فعالیت</span><strong>@Model.PlannerProfile.City</strong></div>
            <div class="detail-block"><span>میانگین امتیاز</span><strong>@DisplayFormatter.ToPersianDigits(Model.PlannerProfile.AverageRating.ToString("0.0"))</strong></div>
            <div class="detail-block"><span>رویداد برگزارشده</span><strong>@DisplayFormatter.Count(Model.PlannerProfile.HostedEventCount)</strong></div>
            <div class="detail-block"><span>رویداد تکمیل شده</span><strong>@DisplayFormatter.Count(Model.PlannerProfile.CompletedEventCount)</strong></div>
        </div>
        <a asp-page="/Planner/Details" asp-route-id="@Model.PlannerProfile.UserId" class="btn btn-outline-primary mt-3">مشاهده پروفایل کامل برگزارکننده</a>
    </section>
}

<partial name="_StatusTransitionModal" model="Model.CreateStatusTransitionModal()" />
<partial name="_ProfileReviewHistoryModal" model="Model.ProfileReviewHistoryModal" />

@if (Model.Event.ActiveDraft.Faqs.Any(item => !string.IsNullOrWhiteSpace(item.Question) && !string.IsNullOrWhiteSpace(item.Answer)))
{
    <section class="glass-panel p-4 mb-4">
        <h2 class="section-title">سوالات متداول</h2>
        <div class="faq-list">
            @foreach (var faq in Model.Event.ActiveDraft.Faqs.Where(item => !string.IsNullOrWhiteSpace(item.Question) && !string.IsNullOrWhiteSpace(item.Answer)))
            {
                <article class="faq-card">
                    <h3>@faq.Question</h3>
                    <p>@faq.Answer</p>
                </article>
            }
        </div>
    </section>
}

@if (Model.ChangeLogEntries.Count > 0)
{
    <section class="glass-panel p-4">
        <h2 class="section-title">تاریخچه تغییرات رویداد</h2>
        <div class="event-history-list mt-3">
            @foreach (var entry in Model.ChangeLogEntries)
            {
                var badgeClass = entry.Category switch
                {
                    "review" => "status-approved",
                    "assignment" => "status-pending",
                    "lifecycle" => "status-rejected",
                    _ => "status-closed"
                };
                var badgeText = entry.Category switch
                {
                    "review" => "بازبینی",
                    "assignment" => "تخصیص",
                    "lifecycle" => "وضعیت",
                    "pricing" => "مالی",
                    "sale" => "فروش",
                    _ => "ویرایش"
                };

                <article class="event-history-card">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                        <div>
                            <div class="fw-semibold">@entry.Action</div>
                            <div class="event-history-meta">@entry.ActorName در @PersianDateFormatter.Format(entry.CreatedAtUtc, Model.IsRtl)</div>
                        </div>
                        <span class="status-badge @badgeClass">@badgeText</span>
                    </div>
                    <div class="event-history-summary">@entry.Summary</div>
                    @if (!string.IsNullOrWhiteSpace(entry.Details))
                    {
                        <div class="event-history-details mt-2">@entry.Details</div>
                    }
                </article>
            }
        </div>
    </section>
}
