@page
@model Randevoo.AdminPanel.Pages.Events.MyModel
@{
    ViewData["Title"] = "رویدادهای من";
}

<section class="page-header">
    <div>
        <h1>رویدادهای من</h1>
    </div>
    <a asp-page="/Events/Edit" class="btn btn-primary">ساخت رویداد</a>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success border-0 mb-4">@Model.StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger border-0 mb-4">@Model.ErrorMessage</div>
}

<div class="glass-panel p-4">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>رویداد</th>
                    <th>زمان شروع</th>
                    <th>وضعیت عملیاتی</th>
                    <th>وضعیت پروفایل</th>
                    <th>نظر مدیر</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Events)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.DisplayTitle</div>
                            <div class="text-muted small">رویداد @item.DisplayCode</div>
                            <div class="text-muted small">@item.ActiveDraft.City</div>
                            @if (item.ActiveDraft.Tags.Count > 0)
                            {
                                <div class="event-chip-list mt-2">
                                    @foreach (var tag in item.ActiveDraft.Tags.Take(3))
                                    {
                                        <span class="event-chip">@tag</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>@PersianDateFormatter.Format(item.ActiveDraft.StartAtUtc, Model.IsRtl)</td>
                        <td><span class="status-badge @Model.GetOperationalStatusClass(item.OperationalStatus)">@DisplayFormatter.OperationalStatus(item.OperationalStatus)</span></td>
                        <td><span class="status-badge @Model.GetProfileStatusClass(item.ApprovalStatus)">@DisplayFormatter.ProfileStatus(item.ApprovalStatus)</span></td>
                        <td class="text-muted">@item.AdminReviewNote</td>
                        <td class="text-end table-action-cell">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle table-action-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    عملیات
                                </button>
                                <div class="dropdown-menu dropdown-menu-end action-menu shadow-sm border-0">
                                    <a asp-page="/Events/Details" asp-route-id="@item.Id" class="dropdown-item">
                                        <i class="bi bi-eye"></i>پروفایل رویداد
                                    </a>
                                    <a asp-page="/Events/Edit" asp-route-id="@item.Id" class="dropdown-item">
                                        <i class="bi bi-pencil-square"></i>ویرایش رویداد
                                    </a>
                                    <a asp-page="/Events/Faqs" asp-route-eventId="@item.Id" class="dropdown-item">
                                        <i class="bi bi-question-circle"></i>سوالات متداول
                                    </a>
                                    <a asp-page="/Participants/Index" asp-route-EventId="@item.Id" class="dropdown-item">
                                        <i class="bi bi-people"></i>فهرست شرکت‌کنندگان
                                    </a>
                                    <a asp-page="/Buyers/Index" asp-route-EventId="@item.Id" class="dropdown-item">
                                        <i class="bi bi-bag-check"></i>خریداران بلیت
                                    </a>
                                    <a asp-page="/Events/Sms" asp-route-eventId="@item.Id" class="dropdown-item">
                                        <i class="bi bi-chat-dots"></i>پیام به شرکت کنندگان
                                    </a>
                                    <a asp-page="/Public/Event" asp-route-id="@item.Id" class="dropdown-item">
                                        <i class="bi bi-box-arrow-up-left"></i>نمایش عمومی
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#eventStatusTransitionModal-@item.Id">
                                        <i class="bi bi-arrow-repeat"></i>تغییر وضعیت رویداد
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@foreach (var item in Model.Events)
{
    <partial name="_StatusTransitionModal" model="Model.CreateStatusTransitionModal(item)" />
}
