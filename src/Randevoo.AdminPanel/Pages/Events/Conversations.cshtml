@page "{eventId:long}"
@model Randevoo.AdminPanel.Pages.Events.ConversationsModel
@{
    ViewData["Title"] = "مانیتور گفتگوهای رویداد";
}

<section class="page-header">
    <div>
        <h1>مانیتور گفتگوهای رویداد</h1>
    </div>
    <a asp-page="/Events/Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i>بازگشت به رویدادها</a>
</section>

<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="section-title mb-1">گفتگوها</h2>
            <p class="text-muted small mb-0">ابتدا گفتگو را انتخاب کنید؛ متن کامل پیام ها در صفحه جداگانه نمایش داده می شود.</p>
        </div>
        <span class="status-badge status-draft">@DisplayFormatter.Count(Model.Conversations.Count) گفتگو</span>
    </div>

    <div class="conversation-inbox-list">
        @foreach (var conversation in Model.Conversations)
        {
            <article class="conversation-inbox-card">
                <div class="conversation-inbox-main">
                    <div class="conversation-inbox-avatar" aria-hidden="true">
                        <i class="bi bi-chat-square-text"></i>
                    </div>
                    <div class="conversation-inbox-content">
                        <div class="conversation-inbox-title-row">
                            <h3>@conversation.StarterName و @conversation.ParticipantName</h3>
                            <span class="status-badge @(conversation.IsDisabled ? "status-rejected" : "status-approved")">@(conversation.IsDisabled ? "غیرفعال" : "فعال")</span>
                        </div>
                        <div class="conversation-inbox-meta">
                            <span>@DisplayFormatter.Count(conversation.MessageCount) پیام</span>
                            <span>شروع: @PersianDateFormatter.Format(conversation.CreatedAtUtc, true)</span>
                            @if (conversation.LastMessageAtUtc.HasValue)
                            {
                                <span>آخرین پیام: @PersianDateFormatter.Format(conversation.LastMessageAtUtc.Value, true)</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(conversation.LastMessageBody))
                        {
                            <p class="conversation-inbox-preview">
                                <strong>@conversation.LastMessageSenderName:</strong>
                                <span>@conversation.LastMessageBody</span>
                            </p>
                        }
                        else
                        {
                            <p class="conversation-inbox-preview text-muted">هنوز پیامی در این گفتگو ثبت نشده است.</p>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(conversation.DisabledReason))
                {
                    <div class="alert alert-warning border-0 py-2 mb-0">@conversation.DisabledReason</div>
                }
                <div class="conversation-inbox-actions">
                    <a asp-page="/Events/Conversation"
                       asp-route-eventId="@Model.EventId"
                       asp-route-conversationId="@conversation.Id"
                       class="btn btn-primary">
                        <i class="bi bi-eye"></i>
                        مشاهده چت
                    </a>
                </div>
            </article>
        }
    </div>
    @if (Model.Conversations.Count == 0)
    {
        <div class="empty-state">برای این رویداد گفتگویی ثبت نشده است.</div>
    }
</div>
