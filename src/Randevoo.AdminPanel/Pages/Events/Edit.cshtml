@page "{id?}"
@model Randevoo.AdminPanel.Pages.Events.EditModel
@using System.Globalization
@{
    ViewData["Title"] = Model.IsNew ? "ساخت رویداد" : "ویرایش رویداد";
    var currentCurrencyTitle = Model.CurrencyOptions.FirstOrDefault(item => item.Value == Model.Input.MaleTicketCurrencyCode)?.Text
        ?? Model.Input.MaleTicketCurrencyCode;
}

<section class="page-header">
    <div>
        <h1>@(Model.IsNew ? "ساخت رویداد" : "ویرایش رویداد")</h1>
    </div>
    @if (!Model.IsNew)
    {
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#eventStatusGuideModal">
                <i class="bi bi-info-circle"></i>
                <span>راهنمای وضعیت</span>
            </button>
            <a asp-page="/Events/Details" asp-route-id="@Model.ExistingEventId" class="btn btn-outline-secondary">
                <i class="bi bi-eye"></i>
                <span>پروفایل رویداد</span>
            </a>
        </div>
    }
    else
    {
        <button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#eventStatusGuideModal">
            <i class="bi bi-info-circle"></i>
            <span>راهنمای وضعیت</span>
        </button>
    }
</section>

<form method="post" enctype="multipart/form-data" class="glass-panel p-4 event-form event-wizard-form" data-event-wizard-form="true">
    <input type="hidden" asp-for="ExistingEventId" />
    <input type="hidden" asp-for="Input.Image1" />
    <input type="hidden" asp-for="Input.Image2" />
    <input type="hidden" asp-for="Input.Image3" />
    <input type="hidden" asp-for="Input.Latitude" />
    <input type="hidden" asp-for="Input.Longitude" />
    <input type="hidden" asp-for="Input.OrganizerCommissionPercent" />
    <input type="hidden" asp-for="SubmitAction" value="draft" data-event-submit-action />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-4"></div>

    <div class="event-edit-actionbar event-wizard-actionbar">
        <div class="event-edit-status">
            <div class="event-status-row">
                <span>وضعیت عملیاتی</span>
                <span class="status-badge @Model.StatusClass">@DisplayFormatter.OperationalStatus(Model.StatusValue)</span>
            </div>
            <div class="event-status-row">
                <span>وضعیت پروفایل</span>
                <span class="status-badge @Model.ProfileStatusClass">@DisplayFormatter.ProfileStatus(Model.ProfileStatusValue)</span>
            </div>
            @if (!Model.IsNew)
            {
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#eventProfileReviewHistoryModal-@Model.ExistingEventId">
                    <i class="bi bi-clock-history"></i>
                    بررسی‌های مدیر
                </button>
            }
        </div>
        <div class="event-edit-actions">
            <a asp-page="/Events/My" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </div>

    <nav class="event-wizard-steps" aria-label="مراحل فرم رویداد">
        <button type="button" class="event-wizard-step is-active" data-event-wizard-target="basic" aria-current="step">
            <span class="event-wizard-step-index">1</span>
            <span class="event-wizard-step-label">اطلاعات پایه</span>
        </button>
        <button type="button" class="event-wizard-step" data-event-wizard-target="schedule">
            <span class="event-wizard-step-index">2</span>
            <span class="event-wizard-step-label">زمان‌بندی</span>
        </button>
        <button type="button" class="event-wizard-step" data-event-wizard-target="audience">
            <span class="event-wizard-step-index">3</span>
            <span class="event-wizard-step-label">مخاطبان</span>
        </button>
        <button type="button" class="event-wizard-step" data-event-wizard-target="content">
            <span class="event-wizard-step-index">4</span>
            <span class="event-wizard-step-label">محتوا</span>
        </button>
        <button type="button" class="event-wizard-step" data-event-wizard-target="images">
            <span class="event-wizard-step-index">5</span>
            <span class="event-wizard-step-label">تصاویر</span>
        </button>
        <button type="button" class="event-wizard-step" data-event-wizard-target="finance">
            <span class="event-wizard-step-index">6</span>
            <span class="event-wizard-step-label">مالی</span>
        </button>
        <button type="button" class="event-wizard-step" data-event-wizard-target="review">
            <span class="event-wizard-step-index">7</span>
            <span class="event-wizard-step-label">مرور و ثبت</span>
        </button>
    </nav>

    <section class="event-wizard-panel is-active" data-event-wizard-panel="basic" aria-label="اطلاعات پایه و نحوه برگزاری">
        <div class="event-wizard-panel-head">
            <h2 class="section-title">اطلاعات پایه و نحوه برگزاری</h2>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.Title" class="form-label">عنوان رویداد</label>
                <input asp-for="Input.Title" class="form-control" placeholder="مثلاً شب اجتماعی تهران" />
                <span asp-validation-for="Input.Title" class="text-danger small"></span>
            </div>
            @if (Model.IsAdmin)
            {
                <div class="col-md-6">
                    <label asp-for="AssignedPlannerId" class="form-label">برگزارکننده</label>
                    <select asp-for="AssignedPlannerId" class="form-select" asp-items="Model.PlannerOptions" data-searchable-select="true" data-search-placeholder="جستجوی برگزارکننده">
                        <option value="">انتخاب برگزارکننده</option>
                    </select>
                    <span asp-validation-for="AssignedPlannerId" class="text-danger small"></span>
                </div>
            }
            <div class="col-md-6">
                <label asp-for="Input.EventTypeId" class="form-label">نوع رویداد</label>
                <select asp-for="Input.EventTypeId" class="form-select" asp-items="Model.EventTypeOptions" data-searchable-select="true" data-search-placeholder="جستجوی نوع رویداد"></select>
                <span asp-validation-for="Input.EventTypeId" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label class="form-label">نحوه برگزاری</label>
                <div class="choice-group" data-event-mode-selector="true">
                    @foreach (var mode in Model.EventModeOptions)
                    {
                        var inputId = $"event-mode-{mode.Value}";
                        <input class="btn-check" type="radio" asp-for="Input.EventModeId" id="@inputId" value="@mode.Value" />
                        <label class="btn btn-outline-primary" for="@inputId">@mode.Text</label>
                    }
                </div>
                <span asp-validation-for="Input.EventModeId" class="text-danger small"></span>
            </div>

            <div class="col-md-4" data-online-section="true">
                <label asp-for="Input.OnlineEventPlatformId" class="form-label">پلتفرم آنلاین</label>
                <select asp-for="Input.OnlineEventPlatformId" class="form-select" asp-items="Model.OnlinePlatformOptions">
                    <option value="">انتخاب پلتفرم</option>
                </select>
                <span asp-validation-for="Input.OnlineEventPlatformId" class="text-danger small"></span>
            </div>
            <div class="col-md-8" data-online-section="true">
                <label asp-for="Input.OnlineJoinUrl" class="form-label">لینک ورود</label>
                <input asp-for="Input.OnlineJoinUrl" class="form-control" dir="ltr" placeholder="https://meet.google.com/..." />
                <span asp-validation-for="Input.OnlineJoinUrl" class="text-danger small"></span>
            </div>
            <div class="col-12" data-online-section="true">
                <label asp-for="Input.OnlineAccessInstructions" class="form-label">راهنمای ورود آنلاین</label>
                <textarea asp-for="Input.OnlineAccessInstructions" class="form-control" rows="3"></textarea>
            </div>

            <div class="col-md-6" data-location-section="true">
                <label asp-for="Input.VenueName" class="form-label">نام محل برگزاری</label>
                <input asp-for="Input.VenueName" class="form-control" />
            </div>
            <div class="col-md-6" data-location-section="true">
                <label asp-for="Input.Country" class="form-label">کشور</label>
                <select asp-for="Input.Country" class="form-select" asp-items="Model.CountryOptions" data-country-cascade="true" data-searchable-select="true" data-search-placeholder="جستجوی کشور"></select>
                <span asp-validation-for="Input.Country" class="text-danger small"></span>
            </div>
            <div class="col-md-6" data-location-section="true">
                <label asp-for="Input.City" class="form-label">شهر</label>
                <select asp-for="Input.City" class="form-select" asp-items="Model.CityOptions" data-city-cascade="true" data-searchable-select="true" data-search-placeholder="جستجوی شهر"></select>
                <span asp-validation-for="Input.City" class="text-danger small"></span>
            </div>
            <div class="col-md-6" data-location-section="true">
                <label asp-for="Input.Region" class="form-label">منطقه</label>
                <input asp-for="Input.Region" class="form-control" list="regionSuggestions" placeholder="مثلاً پردیس" />
                <datalist id="regionSuggestions">
                    <option value="مرکز شهر"></option>
                    <option value="شمال"></option>
                    <option value="جنوب"></option>
                    <option value="شرق"></option>
                    <option value="غرب"></option>
                    <option value="پردیس"></option>
                </datalist>
            </div>
            <div class="col-12" data-location-section="true">
                <label asp-for="Input.Address" class="form-label">آدرس</label>
                <input asp-for="Input.Address" class="form-control" />
                <span asp-validation-for="Input.Address" class="text-danger small"></span>
            </div>
            <div class="col-12" data-location-section="true">
                <label class="form-label form-label-with-help">
                    <span>محل دقیق روی نقشه</span>
                    <button type="button"
                            class="help-icon-button"
                            data-bs-toggle="tooltip"
                            data-bs-placement="bottom"
                            data-bs-custom-class="rv-tooltip"
                            data-bs-title="شهر را انتخاب کنید و پین را روی محل دقیق قرار دهید."
                            aria-label="راهنمای نقشه">
                        <i class="bi bi-info-circle"></i>
                    </button>
                </label>
                <div id="eventMap" class="event-map"></div>
            </div>
        </div>
    </section>

    <section class="event-wizard-panel" data-event-wizard-panel="schedule" aria-label="زمان‌بندی">
        <div class="event-wizard-panel-head">
            <h2 class="section-title">زمان‌بندی</h2>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">تاریخ شروع</label>
                @if (Model.IsRtl)
                {
                    <input asp-for="StartDateText" class="form-control jalali-date-picker" placeholder="۱۴۰۵/۰۳/۱۵" autocomplete="off" />
                }
                else
                {
                    <input asp-for="StartDateText" class="form-control" type="date" />
                }
                <span asp-validation-for="StartDateText" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">ساعت شروع</label>
                <input asp-for="StartTimeText" class="form-control" type="time" />
                <span asp-validation-for="StartTimeText" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">تاریخ پایان</label>
                @if (Model.IsRtl)
                {
                    <input asp-for="EndDateText" class="form-control jalali-date-picker" placeholder="۱۴۰۵/۰۳/۱۵" autocomplete="off" />
                }
                else
                {
                    <input asp-for="EndDateText" class="form-control" type="date" />
                }
                <span asp-validation-for="EndDateText" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">ساعت پایان</label>
                <input asp-for="EndTimeText" class="form-control" type="time" />
                <span asp-validation-for="EndTimeText" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <div class="event-duration-panel" data-event-duration-panel="true">
                    <div>
                        <span>مدت رویداد</span>
                        <strong data-event-duration-value="true">برای محاسبه مدت، شروع و پایان را کامل کنید.</strong>
                    </div>
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
        </div>
    </section>

    <section class="event-wizard-panel" data-event-wizard-panel="audience" aria-label="مخاطبان">
        <div class="event-wizard-panel-head">
            <h2 class="section-title">مخاطبان</h2>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.MinimumEducationLevelId" class="form-label">حداقل سطح تحصیل</label>
                <select asp-for="Input.MinimumEducationLevelId" class="form-select" asp-items="Model.MinimumEducationLevelOptions"></select>
                <span asp-validation-for="Input.MinimumEducationLevelId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.LikeLimit" class="form-label form-label-with-help">
                    <span>تعداد لایک مجاز</span>
                    <button type="button"
                            class="help-icon-button"
                            data-bs-toggle="tooltip"
                            data-bs-placement="bottom"
                            data-bs-custom-class="rv-tooltip"
                            data-bs-title="در پایان رویداد، هر شرکت‌کننده تا این تعداد انتخاب دارد."
                            aria-label="راهنمای محدودیت لایک">
                        <i class="bi bi-info-circle"></i>
                    </button>
                </label>
                <input asp-for="Input.LikeLimit" class="form-control" type="number" min="@EditModel.MinLikeLimit" max="@EditModel.MaxLikeLimit" step="1" data-number-range="true" data-number-label="تعداد لایک مجاز" />
                <div class="form-text">عدد استاندارد این بخش بین @EditModel.MinLikeLimit تا @EditModel.MaxLikeLimit است.</div>
                <span asp-validation-for="Input.LikeLimit" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <div class="gender-field-grid">
                    <section class="gender-field-panel gender-field-panel-male">
                        <div class="gender-field-panel-head">
                            <h3>
                                <i class="bi bi-gender-male" aria-hidden="true"></i>
                                <span>آقایان</span>
                            </h3>
                        </div>
                        <div class="gender-ticket-fields">
                            <div class="gender-ticket-row gender-ticket-row-price">
                                <div class="gender-ticket-field">
                                    <label asp-for="Input.MaleTicketPrice" class="form-label">مبلغ بلیت آقایان</label>
                                    <input asp-for="Input.MaleTicketPrice" class="form-control money-input" type="text" inputmode="numeric" autocomplete="off" data-ticket-price="true" data-ticket-label="مبلغ بلیت آقایان" />
                                    <div class="form-text">ارزش بلیت باید در بازه منطقی رویداد باشد؛ سیستم آن را بر اساس ارز انتخاب‌شده کنترل می‌کند.</div>
                                    <span asp-validation-for="Input.MaleTicketPrice" class="text-danger small"></span>
                                </div>
                                <div class="gender-ticket-field">
                                    <label asp-for="Input.MaleTicketCurrencyCode" class="form-label">واحد پول رویداد</label>
                                    @if (Model.IsEventCurrencyLocked)
                                    {
                                        <input type="hidden" asp-for="Input.MaleTicketCurrencyCode" data-event-currency-source="true" />
                                        <select id="EventCurrencyDisplaySelect" class="form-select" disabled aria-label="واحد پول رویداد">
                                            @foreach (var option in Model.CurrencyOptions)
                                            {
                                                if (string.Equals(option.Value, Model.Input.MaleTicketCurrencyCode, StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <option value="@option.Value" selected>@option.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@option.Value">@option.Text</option>
                                                }
                                            }
                                        </select>
                                        <div class="form-text">به دلیل وجود خرید، رسید یا تراکنش مالی، ارز این رویداد قابل تغییر نیست.</div>
                                    }
                                    else
                                    {
                                        <select asp-for="Input.MaleTicketCurrencyCode" class="form-select" asp-items="Model.CurrencyOptions" data-event-currency-source="true"></select>
                                        <div class="form-text">ارز قیمت‌گذاری بلیت‌ها و پرداخت‌های این رویداد. بعد از اولین فعالیت مالی قفل می‌شود.</div>
                                    }
                                    <span asp-validation-for="Input.MaleTicketCurrencyCode" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="gender-ticket-row gender-ticket-row-meta">
                                <div class="gender-ticket-field">
                                    <label asp-for="Input.CapacityMale" class="form-label">ظرفیت</label>
                                    <input asp-for="Input.CapacityMale" class="form-control" type="number" min="@EditModel.MinGenderCapacity" max="@EditModel.MaxGenderCapacity" step="1" data-number-range="true" data-number-label="ظرفیت آقایان" />
                                    <div class="form-text">@EditModel.MinGenderCapacity تا @EditModel.MaxGenderCapacity نفر</div>
                                    <span asp-validation-for="Input.CapacityMale" class="text-danger small"></span>
                                </div>
                                <div class="gender-ticket-field">
                                    <label asp-for="Input.AgeRangeForMale" class="form-label">بازه سنی</label>
                                    <select asp-for="Input.AgeRangeForMale" class="form-select" asp-items="Model.AgeRangeOptions"></select>
                                    <span asp-validation-for="Input.AgeRangeForMale" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="gender-field-panel gender-field-panel-female">
                        <div class="gender-field-panel-head">
                            <h3>
                                <i class="bi bi-gender-female" aria-hidden="true"></i>
                                <span>خانم‌ها</span>
                            </h3>
                        </div>
                        <div class="gender-ticket-fields">
                            <div class="gender-ticket-row gender-ticket-row-price">
                                <div class="gender-ticket-field">
                                    <label asp-for="Input.FemaleTicketPrice" class="form-label">مبلغ بلیت خانم‌ها</label>
                                    <input asp-for="Input.FemaleTicketPrice" class="form-control money-input" type="text" inputmode="numeric" autocomplete="off" data-ticket-price="true" data-ticket-label="مبلغ بلیت خانم‌ها" />
                                    <div class="form-text">برای جلوگیری از مبلغ غیرعادی، معادل ریالی بلیت هم بررسی می‌شود.</div>
                                    <span asp-validation-for="Input.FemaleTicketPrice" class="text-danger small"></span>
                                </div>
                                <div class="gender-ticket-field">
                                    <label asp-for="Input.FemaleTicketCurrencyCode" class="form-label">واحد پول رویداد</label>
                                    <input type="hidden" asp-for="Input.FemaleTicketCurrencyCode" data-event-currency-target="true" />
                                    <input type="text" class="form-control event-currency-display" value="@currentCurrencyTitle" readonly data-event-currency-display="true" aria-label="واحد پول رویداد" />
                                    <span asp-validation-for="Input.FemaleTicketCurrencyCode" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="gender-ticket-row gender-ticket-row-meta">
                                <div class="gender-ticket-field">
                                    <label asp-for="Input.CapacityFemale" class="form-label">ظرفیت</label>
                                    <input asp-for="Input.CapacityFemale" class="form-control" type="number" min="@EditModel.MinGenderCapacity" max="@EditModel.MaxGenderCapacity" step="1" data-number-range="true" data-number-label="ظرفیت بانوان" />
                                    <div class="form-text">@EditModel.MinGenderCapacity تا @EditModel.MaxGenderCapacity نفر</div>
                                    <span asp-validation-for="Input.CapacityFemale" class="text-danger small"></span>
                                </div>
                                <div class="gender-ticket-field">
                                    <label asp-for="Input.AgeRangeForFemale" class="form-label">بازه سنی</label>
                                    <select asp-for="Input.AgeRangeForFemale" class="form-select" asp-items="Model.AgeRangeOptions"></select>
                                    <span asp-validation-for="Input.AgeRangeForFemale" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </section>

    <section class="event-wizard-panel" data-event-wizard-panel="content" aria-label="محتوا">
        <div class="event-wizard-panel-head">
            <h2 class="section-title">محتوا</h2>
        </div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Input.TagIds" class="form-label">تگ‌های رویداد</label>
                <div class="tag-combo"
                     data-tag-combo="true"
                     data-tag-select-target="#Input_TagIds"
                     data-tag-picker-target="#eventTagPicker"
                     data-tag-preview-target="#eventTagPreview">
                    <select id="eventTagPicker" class="form-select tag-combo-picker" data-searchable-select="true" data-search-placeholder="جستجوی تگ">
                        <option value="">انتخاب تگ از لیست</option>
                        @foreach (var item in Model.TagOptions)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                    <div id="eventTagPreview" class="tag-preview-list tag-combo-preview"></div>
                    <select id="Input_TagIds" name="Input.TagIds" class="d-none" multiple aria-hidden="true" tabindex="-1">
                        @foreach (var item in Model.TagOptions)
                        {
                            <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                        }
                    </select>
                </div>
                <span asp-validation-for="Input.TagIds" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label class="form-label">توضیحات</label>
                <div class="quill-shell">
                    <input type="hidden" asp-for="Input.DescriptionHtml" class="quill-value" />
                    <div id="eventDescriptionEditor" class="quill-editor" data-input="#Input_DescriptionHtml" data-placeholder="جزئیات رویداد را بنویسید."></div>
                </div>
                <span asp-validation-for="Input.DescriptionHtml" class="text-danger small"></span>
            </div>
        </div>
    </section>

    <section class="event-wizard-panel" data-event-wizard-panel="images" aria-label="تصاویر رویداد">
        <div class="event-wizard-panel-head">
            <h2 class="section-title">تصاویر رویداد</h2>
        </div>

        <div class="event-image-tabs-panel">
            <div class="event-image-standard-card mb-3">
                <div>
                    <strong>استاندارد تصویر رویداد</strong>
                    <span>برای اینکه کارت رویداد، اسلایدر و صفحه عمومی به‌هم نریزد، همه تصاویر باید افقی و با نسبت @EditModel.EventImageAspectWidth:@EditModel.EventImageAspectHeight باشند. حداقل ابعاد @EditModel.MinEventImageWidth×@EditModel.MinEventImageHeight پیکسل، فرمت مجاز JPG یا PNG و حجم مجاز حداکثر ۵ مگابایت است.</span>
                </div>
                <span class="image-manager-counter">3 / 3</span>
            </div>

            <ul class="nav nav-pills event-image-tabs mb-4" id="eventImageTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="event-image-1-tab" data-bs-toggle="tab" data-bs-target="#event-image-1-pane" type="button" role="tab" aria-controls="event-image-1-pane" aria-selected="true">
                        <span class="event-image-tab-number">1</span>
                        <span>کاور</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="event-image-2-tab" data-bs-toggle="tab" data-bs-target="#event-image-2-pane" type="button" role="tab" aria-controls="event-image-2-pane" aria-selected="false">
                        <span class="event-image-tab-number">2</span>
                        <span>لوکیشن</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="event-image-3-tab" data-bs-toggle="tab" data-bs-target="#event-image-3-pane" type="button" role="tab" aria-controls="event-image-3-pane" aria-selected="false">
                        <span class="event-image-tab-number">3</span>
                        <span>تجربه</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content event-image-tab-content" id="eventImageTabContent">
                <div class="tab-pane fade show active" id="event-image-1-pane" role="tabpanel" aria-labelledby="event-image-1-tab" tabindex="0">
                    <div class="image-manager-card image-manager-card-tabbed">
                        <div class="image-slot-head">
                            <div class="fw-semibold">تصویر اول</div>
                            <div class="image-slot-actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary image-revert-button d-none" data-target="#preview1" data-hidden-target="#Input_Image1" data-file-target="#Image1File">انصراف از تغییر</button>
                                <button type="button" class="btn btn-sm btn-light image-clear-button" data-target="#preview1" data-hidden-target="#Input_Image1" data-file-target="#Image1File">حذف</button>
                            </div>
                        </div>
                        <div class="image-manager-preview-shell @(string.IsNullOrWhiteSpace(Model.Input.Image1) ? "is-empty" : string.Empty)">
                            <img id="preview1" src="@Model.Input.Image1" alt="تصویر اول" class="image-manager-preview @(string.IsNullOrWhiteSpace(Model.Input.Image1) ? "d-none" : string.Empty)" />
                            <div class="image-manager-placeholder">
                                <i class="bi bi-image"></i>
                                <span>کاور اصلی</span>
                            </div>
                        </div>
                        <input type="file" class="form-control image-input" asp-for="Image1File" accept="image/jpeg,image/png" data-target="#preview1" data-event-image-input="true" data-image-label="تصویر اول" />
                        <div class="form-text">برای کاور، تصویر افقی با نسبت @EditModel.EventImageAspectWidth:@EditModel.EventImageAspectHeight انتخاب کنید.</div>
                        <span asp-validation-for="Image1File" class="text-danger small d-block mt-1 image-upload-validation"></span>
                    </div>
                </div>

                <div class="tab-pane fade" id="event-image-2-pane" role="tabpanel" aria-labelledby="event-image-2-tab" tabindex="0">
                    <div class="image-manager-card image-manager-card-tabbed">
                        <div class="image-slot-head">
                            <div class="fw-semibold">تصویر دوم</div>
                            <div class="image-slot-actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary image-revert-button d-none" data-target="#preview2" data-hidden-target="#Input_Image2" data-file-target="#Image2File">انصراف از تغییر</button>
                                <button type="button" class="btn btn-sm btn-light image-clear-button" data-target="#preview2" data-hidden-target="#Input_Image2" data-file-target="#Image2File">حذف</button>
                            </div>
                        </div>
                        <div class="image-manager-preview-shell @(string.IsNullOrWhiteSpace(Model.Input.Image2) ? "is-empty" : string.Empty)">
                            <img id="preview2" src="@Model.Input.Image2" alt="تصویر دوم" class="image-manager-preview @(string.IsNullOrWhiteSpace(Model.Input.Image2) ? "d-none" : string.Empty)" />
                            <div class="image-manager-placeholder">
                                <i class="bi bi-geo-alt"></i>
                                <span>لوکیشن</span>
                            </div>
                        </div>
                        <input type="file" class="form-control image-input" asp-for="Image2File" accept="image/jpeg,image/png" data-target="#preview2" data-event-image-input="true" data-image-label="تصویر دوم" />
                        <div class="form-text">تصاویر هم‌نسبت، کارت رویداد و اسلایدر را مرتب نگه می‌دارند.</div>
                        <span asp-validation-for="Image2File" class="text-danger small d-block mt-1 image-upload-validation"></span>
                    </div>
                </div>

                <div class="tab-pane fade" id="event-image-3-pane" role="tabpanel" aria-labelledby="event-image-3-tab" tabindex="0">
                    <div class="image-manager-card image-manager-card-tabbed">
                        <div class="image-slot-head">
                            <div class="fw-semibold">تصویر سوم</div>
                            <div class="image-slot-actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary image-revert-button d-none" data-target="#preview3" data-hidden-target="#Input_Image3" data-file-target="#Image3File">انصراف از تغییر</button>
                                <button type="button" class="btn btn-sm btn-light image-clear-button" data-target="#preview3" data-hidden-target="#Input_Image3" data-file-target="#Image3File">حذف</button>
                            </div>
                        </div>
                        <div class="image-manager-preview-shell @(string.IsNullOrWhiteSpace(Model.Input.Image3) ? "is-empty" : string.Empty)">
                            <img id="preview3" src="@Model.Input.Image3" alt="تصویر سوم" class="image-manager-preview @(string.IsNullOrWhiteSpace(Model.Input.Image3) ? "d-none" : string.Empty)" />
                            <div class="image-manager-placeholder">
                                <i class="bi bi-stars"></i>
                                <span>تجربه</span>
                            </div>
                        </div>
                        <input type="file" class="form-control image-input" asp-for="Image3File" accept="image/jpeg,image/png" data-target="#preview3" data-event-image-input="true" data-image-label="تصویر سوم" />
                        <div class="form-text">حداقل ابعاد مجاز @EditModel.MinEventImageWidth×@EditModel.MinEventImageHeight پیکسل است.</div>
                        <span asp-validation-for="Image3File" class="text-danger small d-block mt-1 image-upload-validation"></span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="event-wizard-panel" data-event-wizard-panel="finance" aria-label="مالی">
        <div class="event-wizard-panel-head">
            <h2 class="section-title">مالی</h2>
        </div>

        <section class="payment-method-panel" data-payment-method-panel="true">
            <div class="payment-method-head">
                <div>
                    <h3>روش دریافت هزینه رویداد</h3>
                    <p>مشخص کنید پول اول به حساب پلتفرم می‌آید یا مستقیم به حساب برگزارکننده و سیستم چطور سهم‌ها را حساب کند.</p>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm" data-financial-calc-button="true">
                    <i class="bi bi-calculator"></i>
                    <span>محاسبه</span>
                </button>
            </div>

            <div class="payment-method-options" role="radiogroup" aria-label="روش دریافت هزینه رویداد">
                <label class="payment-method-option">
                    <input asp-for="Input.PaymentCollectionMethod" id="PaymentCollectionMethod_PlatformGateway" type="radio" value="@Randevoo.Domain.Enums.EventPaymentCollectionMethod.PlatformGateway" />
                    <span>
                        <strong>پرداخت آنلاین از طریق درگاه پلتفرم</strong>
                        <small>پرداخت خودکار تایید می‌شود و سهم برگزارکننده پس از کسر کمیسیون قابل برداشت است.</small>
                    </span>
                </label>
                <label class="payment-method-option">
                    <input asp-for="Input.PaymentCollectionMethod" id="PaymentCollectionMethod_PlatformManualTransfer" type="radio" value="@Randevoo.Domain.Enums.EventPaymentCollectionMethod.PlatformManualTransfer" />
                    <span>
                        <strong>واریز به حساب پلتفرم و تایید توسط پشتیبانی</strong>
                        <small>شرکت‌کننده رسید می‌فرستد؛ بعد از تایید پشتیبانی، سهم برگزارکننده قابل برداشت می‌شود.</small>
                    </span>
                </label>
                <label class="payment-method-option">
                    <input asp-for="Input.PaymentCollectionMethod" id="PaymentCollectionMethod_OrganizerManualTransfer" type="radio" value="@Randevoo.Domain.Enums.EventPaymentCollectionMethod.OrganizerManualTransfer" />
                    <span>
                        <strong>واریز مستقیم به حساب برگزارکننده و تایید توسط برگزارکننده</strong>
                        <small>پول مستقیم نزد برگزارکننده می‌ماند و کمیسیون پلتفرم به عنوان بدهی او ثبت می‌شود.</small>
                    </span>
                </label>
            </div>
            <span asp-validation-for="Input.PaymentCollectionMethod" class="text-danger small"></span>

            <div class="organizer-payment-instructions mt-3" data-organizer-payment-instructions="true">
                <label asp-for="Input.OrganizerPaymentAccountId" class="form-label">حساب دریافت وجه برگزارکننده</label>
                <select asp-for="Input.OrganizerPaymentAccountId"
                        class="form-select"
                        asp-items="Model.OrganizerPaymentAccountOptions"
                        data-organizer-payment-account-select="true"
                        data-searchable-select="true"
                        data-search-placeholder="جستجوی حساب دریافت وجه">
                    <option value="">انتخاب حساب</option>
                </select>
                @if (!string.IsNullOrWhiteSpace(Model.OrganizerPaymentAccountWarning))
                {
                    <div class="form-text organizer-payment-warning" data-organizer-payment-warning="true">@Model.OrganizerPaymentAccountWarning</div>
                }
                else
                {
                    <div class="form-text organizer-payment-warning d-none" data-organizer-payment-warning="true"></div>
                }
                <span asp-validation-for="Input.OrganizerPaymentAccountId" class="text-danger small"></span>
            </div>

            <div class="financial-preview-grid mt-3" data-financial-preview="finance">
                <div class="financial-preview-item">
                    <span>فروش کل احتمالی</span>
                    <strong data-financial-value="gross-total">0</strong>
                    <small data-financial-value="gross-total-irr">0</small>
                </div>
                <div class="financial-preview-item">
                    <span>کمیسیون پلتفرم</span>
                    <strong data-financial-value="platform-commission-total">0</strong>
                    <small data-financial-value="platform-commission-total-irr">0</small>
                </div>
                <div class="financial-preview-item">
                    <span>سهم خالص برگزارکننده</span>
                    <strong data-financial-value="organizer-net-total">0</strong>
                    <small data-financial-value="organizer-net-total-irr">0</small>
                </div>
                <div class="financial-preview-item financial-preview-note">
                    <span>اثر روی حساب برگزارکننده</span>
                    <strong data-financial-value="settlement-effect">ثبت نشده</strong>
                </div>
            </div>
            <div class="help-tip mt-2" data-financial-value="settlement-note"></div>
        </section>
    </section>

    <section class="event-wizard-panel" data-event-wizard-panel="review" aria-label="مرور و ثبت">
        <div class="event-wizard-panel-head">
            <h2 class="section-title">مرور و ثبت</h2>
            <button type="button" class="btn btn-outline-primary btn-sm" data-event-review-print="true">
                <i class="bi bi-printer"></i>
                <span>چاپ مرور</span>
            </button>
        </div>

        <div class="event-review-summary event-review-summary-wide event-review-print-area" data-event-review-summary="true">
            <div class="detail-block"><span>عنوان</span><strong data-review-value="title">@(string.IsNullOrWhiteSpace(Model.Input.Title) ? "ثبت نشده" : Model.Input.Title)</strong></div>
            <div class="detail-block"><span>برگزارکننده</span><strong data-review-value="planner">@(Model.PlannerOptions.FirstOrDefault(item => item.Value == Model.AssignedPlannerId?.ToString())?.Text ?? "ثبت نشده")</strong></div>
            <div class="detail-block"><span>نوع</span><strong data-review-value="event-type">@(string.IsNullOrWhiteSpace(Model.Input.EventTypeName) ? "انتخاب‌شده در فرم" : Model.Input.EventTypeName)</strong></div>
            <div class="detail-block"><span>نحوه برگزاری</span><strong data-review-value="event-mode">@(string.IsNullOrWhiteSpace(Model.Input.EventModeName) ? (Model.Input.IsOnline ? "آنلاین" : "حضوری") : Model.Input.EventModeName)</strong></div>
            <div class="detail-block"><span>محل / آنلاین</span><strong data-review-value="delivery-detail">@(Model.Input.IsOnline ? (string.IsNullOrWhiteSpace(Model.Input.OnlinePlatformName) ? "آنلاین" : Model.Input.OnlinePlatformName) : $"{Model.Input.Country}، {Model.Input.City}")</strong></div>
            <div class="detail-block"><span>آدرس</span><strong data-review-value="address">@(string.IsNullOrWhiteSpace(Model.Input.Address) ? "ثبت نشده" : Model.Input.Address)</strong></div>
            <div class="detail-block"><span>شروع</span><strong data-review-value="start">@PersianDateFormatter.FormatDateTime(Model.Input.StartAtUtc.UtcDateTime, Model.IsRtl)</strong></div>
            <div class="detail-block"><span>پایان</span><strong data-review-value="end">@PersianDateFormatter.FormatDateTime(Model.Input.EndAtUtc.UtcDateTime, Model.IsRtl)</strong></div>
            <div class="detail-block"><span>مدت</span><strong data-review-value="duration">ثبت نشده</strong></div>
            <div class="detail-block"><span>آقایان</span><strong data-review-value="male-ticket">@DisplayFormatter.TicketMoney(Model.Input.MaleTicketPrice, Model.Input.MaleTicketCurrencyCode, Model.IsRtl)</strong></div>
            <div class="detail-block"><span>خانم‌ها</span><strong data-review-value="female-ticket">@DisplayFormatter.TicketMoney(Model.Input.FemaleTicketPrice, Model.Input.FemaleTicketCurrencyCode, Model.IsRtl)</strong></div>
            <div class="detail-block"><span>ظرفیت</span><strong data-review-value="capacity">@($"{Model.Input.CapacityMale} آقا / {Model.Input.CapacityFemale} خانم")</strong></div>
            <div class="detail-block"><span>بازه سنی</span><strong data-review-value="age-range">@($"{Model.Input.AgeRangeForMale} آقا / {Model.Input.AgeRangeForFemale} خانم")</strong></div>
            <div class="detail-block"><span>حداقل تحصیل</span><strong data-review-value="education">ثبت نشده</strong></div>
            <div class="detail-block"><span>لایک مجاز</span><strong data-review-value="like-limit">@Model.Input.LikeLimit</strong></div>
            <div class="detail-block"><span>تگ‌ها</span><strong data-review-value="tags">@(Model.Input.Tags.Count == 0 ? "ثبت نشده" : string.Join("، ", Model.Input.Tags))</strong></div>
            <div class="detail-block"><span>تصاویر</span><strong data-review-value="images">0 / 3</strong></div>
            <div class="detail-block"><span>روش دریافت هزینه</span><strong data-review-value="payment-method">ثبت نشده</strong></div>
            <div class="detail-block detail-block-wide"><span>حساب دریافت وجه برگزارکننده</span><strong data-review-value="organizer-payment">ثبت نشده</strong></div>
            <div class="detail-block detail-block-wide"><span>راهنمای آنلاین</span><strong data-review-value="online-instructions">ثبت نشده</strong></div>
            <div class="detail-block detail-block-wide"><span>توضیحات</span><strong data-review-value="description">ثبت نشده</strong></div>
        </div>

        <div class="financial-review-panel mt-4" data-financial-preview="review">
            <div class="payment-method-head">
                <div>
                    <h3>مرور مالی رویداد</h3>
                    <p>این محاسبه بر اساس ظرفیت کامل، قیمت بلیت‌ها و درصد کمیسیون فعلی انجام می‌شود.</p>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm" data-financial-calc-button="true">
                    <i class="bi bi-calculator"></i>
                    <span>محاسبه مجدد</span>
                </button>
            </div>
            <div class="financial-preview-grid">
                <div class="financial-preview-item">
                    <span>فروش کل احتمالی</span>
                    <strong data-financial-value="gross-total">0</strong>
                    <small data-financial-value="gross-total-irr">0</small>
                </div>
                <div class="financial-preview-item">
                    <span>کمیسیون پلتفرم</span>
                    <strong data-financial-value="platform-commission-total">0</strong>
                    <small data-financial-value="platform-commission-total-irr">0</small>
                </div>
                <div class="financial-preview-item">
                    <span>سهم خالص برگزارکننده</span>
                    <strong data-financial-value="organizer-net-total">0</strong>
                    <small data-financial-value="organizer-net-total-irr">0</small>
                </div>
                <div class="financial-preview-item financial-preview-note">
                    <span>اثر روی حساب برگزارکننده</span>
                    <strong data-financial-value="settlement-effect">ثبت نشده</strong>
                </div>
            </div>
            <div class="help-tip mt-2" data-financial-value="settlement-note"></div>
        </div>
    </section>

    <div class="event-wizard-footer">
        <button type="button" class="btn btn-outline-secondary" data-event-wizard-prev="true">
            <i class="bi bi-chevron-right"></i>
            <span>قبلی</span>
        </button>
        <button type="button" class="btn btn-primary" data-event-wizard-next="true">
            <span>بعدی</span>
            <i class="bi bi-chevron-left"></i>
        </button>
        <button type="submit" class="btn btn-outline-primary d-none" data-event-wizard-submit="true" data-submit-mode="draft">
            <i class="bi bi-save"></i>
            <span>ذخیره پیش‌نویس</span>
        </button>
        <button type="submit" class="btn btn-primary d-none" data-event-wizard-submit="true" data-submit-mode="submit">
            <i class="bi bi-check2-circle"></i>
            <span>ثبت و ارسال برای مدیر</span>
        </button>
    </div>
</form>

@if (!Model.IsNew)
{
    <partial name="_ProfileReviewHistoryModal" model="Model.ProfileReviewHistoryModal" />
}
<partial name="_EventStatusGuideModal" />

@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="~/lib/quill/dist/quill.snow.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/lib/quill/dist/quill.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        window.randevooEventEdit = {
            isRtl: @(Model.IsRtl.ToString().ToLowerInvariant()),
            countrySelector: '#Input_Country',
            citySelector: '#Input_City',
            eventModeSelector: 'input[name="Input.EventModeId"]',
            onlineModeId: '1',
            cityOptions: @Html.Raw(Model.CityOptionsJson),
            currencyRates: @Html.Raw(Model.CurrencyRatesJson),
            organizerPaymentAccounts: @Html.Raw(Model.OrganizerPaymentAccountOptionsJson),
            ticketValueRangeIrr: {
                min: @EditModel.MinTicketValueIrr.ToString(CultureInfo.InvariantCulture),
                max: @EditModel.MaxTicketValueIrr.ToString(CultureInfo.InvariantCulture)
            },
            eventImageStandard: {
                minWidth: @EditModel.MinEventImageWidth,
                minHeight: @EditModel.MinEventImageHeight,
                aspectWidth: @EditModel.EventImageAspectWidth,
                aspectHeight: @EditModel.EventImageAspectHeight,
                maxBytes: @EditModel.MaxEventImageBytes
            },
            latitudeSelector: '#Input_Latitude',
            longitudeSelector: '#Input_Longitude'
        };
    </script>
    <script>
        window.randevooEventWizard = true;
    </script>
}
