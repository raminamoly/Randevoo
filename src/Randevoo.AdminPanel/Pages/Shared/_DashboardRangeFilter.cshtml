@model Randevoo.AdminPanel.Models.Common.DashboardFilterViewModel

<section class="page-header dashboard-header">
    <div>
        <h1>@Model.Title</h1>
    </div>
    <form method="get" asp-page="@Model.PagePath" class="dashboard-range-form">
        <label class="form-label mb-1" for="rangeKey">بازه گزارش</label>
        <div class="dashboard-range-select">
            <select id="rangeKey" name="rangeKey" class="form-select" onchange="this.form.submit()">
                @foreach (var option in Randevoo.AdminPanel.Models.Common.DashboardDateRange.Options)
                {
                    <option value="@option.Key" selected="@(option.Key == Model.CurrentRangeKey ? "selected" : null)">@option.Label</option>
                }
            </select>
        </div>
    </form>
</section>
