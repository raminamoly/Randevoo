@inject Randevoo.AdminPanel.Services.State.CurrentSessionState CurrentSession
@{
    var user = CurrentSession.CurrentUser;
    var role = user is null ? "میهمان" : DisplayFormatter.Role(user.Role);
}

<header class="admin-topbar">
    <div class="topbar-leading d-flex align-items-center gap-3">
        <button class="btn btn-light d-lg-none sidebar-toggle"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#sidebarCollapse"
                aria-controls="sidebarCollapse"
                aria-expanded="false"
                aria-label="باز کردن منو">
            <i class="bi bi-list" aria-hidden="true"></i>
        </button>
        <img src="~/images/logo.png" alt="راندوو" class="topbar-logo" />
        <div>
            <div class="topbar-title">@ViewData["Title"]</div>
        </div>
    </div>

    <div class="topbar-actions">
        <div class="dropdown">
            <button class="btn topbar-user-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="منوی حساب">
                <span class="user-chip">
                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                    <span>
                        <strong>@(user?.FullName ?? "میهمان")</strong>
                        <small>@role</small>
                    </span>
                </span>
            </button>
            <div class="dropdown-menu dropdown-menu-end user-menu shadow-sm border-0">
                <div class="user-menu-summary">
                    <div class="fw-semibold">@(user?.FullName ?? "میهمان")</div>
                    <div class="text-muted small">@role</div>
                </div>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" asp-page="/Account/Logout">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>خروج از حساب
                </a>
            </div>
        </div>
    </div>
</header>
