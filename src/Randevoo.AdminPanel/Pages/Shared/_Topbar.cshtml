@inject Randevoo.AdminPanel.Services.State.CurrentSessionState CurrentSession
@{
    var user = CurrentSession.CurrentUser;
    var role = user is null ? "میهمان" : DisplayFormatter.Role(user.Role);
}

<header class="admin-topbar">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-link d-lg-none p-0 sidebar-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarCollapse" aria-label="باز کردن منو">
            <i class="bi bi-list"></i>
        </button>
        <div>
            <div class="topbar-eyebrow">مرکز عملیات و تایید رویداد</div>
            <div class="topbar-title">@ViewData["Title"]</div>
        </div>
    </div>

    <div class="topbar-actions">
        <span class="user-chip">
            <i class="bi bi-person-circle"></i>
            <span>@(user?.FullName ?? "میهمان")</span>
            <small>@role</small>
        </span>
        <a class="btn btn-outline-dark btn-sm" asp-page="/Account/Logout">
            <i class="bi bi-box-arrow-right ms-1"></i>خروج
        </a>
    </div>
</header>
