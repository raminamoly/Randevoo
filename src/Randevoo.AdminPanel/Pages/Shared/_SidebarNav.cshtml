@inject Randevoo.AdminPanel.Services.State.CurrentSessionState CurrentSession
@{
    var path = Context.Request.Path.Value ?? string.Empty;
    var role = CurrentSession.CurrentUser?.Role.ToString() ?? string.Empty;
    var isPlanner = string.Equals(role, "EventPlanner", StringComparison.OrdinalIgnoreCase);
}

<nav class="nav flex-column sidebar-nav">
    <a class="nav-link @(path.StartsWith("/Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
       asp-page="@(isPlanner ? "/Dashboard/My" : "/Dashboard/Index")">
        <i class="bi bi-grid-1x2-fill"></i><span>داشبورد</span>
    </a>

    @if (isPlanner)
    {
        <a class="nav-link @(path.StartsWith("/Events/My", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
           asp-page="/Events/My">
            <i class="bi bi-calendar-event-fill"></i><span>رویدادهای من</span>
        </a>
        <a class="nav-link @(path.StartsWith("/Planner/Profile", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
           asp-page="/Planner/Profile">
            <i class="bi bi-person-vcard-fill"></i><span>پروفایل برگزارکننده</span>
        </a>
    }
    else
    {
        <a class="nav-link @(path.StartsWith("/Events", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
           asp-page="/Events/Index">
            <i class="bi bi-calendar3"></i><span>رویدادها</span>
        </a>
        <a class="nav-link @(path.StartsWith("/Users", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
           asp-page="/Users/Index">
            <i class="bi bi-people-fill"></i><span>کاربران</span>
        </a>
    }

    <a class="nav-link @(path.StartsWith("/Settings", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
       asp-page="/Settings/Index">
        <i class="bi bi-gear-fill"></i><span>تنظیمات</span>
    </a>
</nav>
