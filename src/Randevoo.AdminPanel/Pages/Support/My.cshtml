@page
@model Randevoo.AdminPanel.Pages.Support.MyModel
@{
    ViewData["Title"] = "تیکت های من با پشتیبانی";
}

<section class="page-header">
    <div>
        <h1>تیکت های من با پشتیبانی</h1>
        <p class="text-muted mb-0">گفت‌وگوی شما با تیم پشتیبانی سایت درباره حساب، مالی، رویدادها و مسائل اجرایی.</p>
    </div>
    <a class="btn btn-primary" asp-page="/Support/Create"><i class="bi bi-plus-circle"></i> تیکت جدید</a>
</section>

<div class="glass-panel p-4">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>عنوان</th>
                    <th>نوع</th>
                    <th>گیرنده</th>
                    <th>وضعیت</th>
                    <th>مسئول</th>
                    <th>زمان ثبت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Tickets)
                {
                    <tr>
                        <td class="fw-semibold">@item.Title</td>
                        <td>@item.TicketTypeTitleFa</td>
                        <td>@item.TicketRecipientTypeTitleFa</td>
                        <td><span class="status-badge">@item.TicketStatusTitleFa</span></td>
                        <td>@(item.AssignedSupportDisplayName ?? item.RecipientPlannerDisplayName ?? "در صف")</td>
                        <td>@PersianDateFormatter.FormatDateTime(item.CreatedAt, true)</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-page="/Support/Details" asp-route-id="@item.Id">مشاهده</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Tickets.Count == 0)
    {
        <div class="empty-state">هنوز تیکتی برای پشتیبانی سایت ثبت نکرده اید.</div>
    }
</div>
