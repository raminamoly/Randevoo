@page
@using Randevoo.AdminPanel.Models.Support
@using Randevoo.Domain.Enums
@model Randevoo.AdminPanel.Pages.Support.TicketsModel
@{
    ViewData["Title"] = "تیکت های سیستم";
}

<section class="page-header support-dashboard-header">
    <div>
        <h1>تیکت های سیستم</h1>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Support/Index">
        <i class="bi bi-speedometer2"></i>
        داشبورد
    </a>
</section>

<form method="get" class="glass-panel support-filter-panel">
    <div class="support-filter-grid">
        <div>
            <label class="form-label" asp-for="CreatedFromJalali">از تاریخ</label>
            <input class="form-control jalali-date-picker" asp-for="CreatedFromJalali" autocomplete="off" placeholder="۱۴۰۵/۰۳/۰۱" />
        </div>
        <div>
            <label class="form-label" asp-for="CreatedToJalali">تا تاریخ</label>
            <input class="form-control jalali-date-picker" asp-for="CreatedToJalali" autocomplete="off" placeholder="۱۴۰۵/۰۳/۳۱" />
        </div>
        <div>
            <label class="form-label" asp-for="TicketTypeId">نوع تیکت</label>
            <select class="form-select" asp-for="TicketTypeId" asp-items="Model.TypeOptions">
                <option value="">همه نوع‌ها</option>
            </select>
        </div>
        <div>
            <label class="form-label" asp-for="TicketRecipientTypeId">گیرنده</label>
            <select class="form-select" asp-for="TicketRecipientTypeId" asp-items="Model.RecipientOptions">
                <option value="">همه گیرنده‌ها</option>
            </select>
        </div>
        <div>
            <label class="form-label" asp-for="SubmitterRole">نوع ثبت کننده</label>
            <select class="form-select" asp-for="SubmitterRole">
                <option value="">همه</option>
                <option value="@((int)UserRole.EndUser)">شرکت‌کننده</option>
                <option value="@((int)UserRole.EventPlanner)">برگزارکننده</option>
            </select>
        </div>
        <div>
            <label class="form-label" asp-for="AssigneeUserId">پشتیبان</label>
            @if (Model.IsAdmin)
            {
                <select class="form-select" asp-for="AssigneeUserId">
                    <option value="">همه پشتیبان ها</option>
                    @foreach (var supportUser in Model.SupportUsers)
                    {
                        <option value="@supportUser.Id">@supportUser.DisplayName</option>
                    }
                </select>
            }
            else
            {
                <input type="hidden" asp-for="AssigneeUserId" value="@Model.AssigneeUserId" />
                <input class="form-control" value="@Model.CurrentSupportDisplayName" readonly />
            }
        </div>
        <div class="support-filter-actions">
            <button class="btn btn-primary" type="submit"><i class="bi bi-funnel"></i> اعمال فیلتر</button>
            <a class="btn btn-light" asp-page="/Support/Tickets"><i class="bi bi-arrow-counterclockwise"></i> پاک کردن</a>
        </div>
    </div>
</form>

<div class="glass-panel support-table-panel">
    <div class="support-table-header">
        <div>
            <h2>تیکت های سیستم</h2>
        </div>
        <span class="status-badge">@Model.Tickets.Count مورد</span>
    </div>

    <ul class="nav nav-pills support-status-tabs" role="tablist">
        @for (var index = 0; index < Model.StatusTabs.Count; index++)
        {
            var status = Model.StatusTabs[index];
            var count = Model.Tickets.Count(ticket => ticket.TicketStatusId == status.Id);
            <li class="nav-item" role="presentation">
                <button class="nav-link @(index == 0 ? "active" : string.Empty)"
                        id="ticket-status-@(status.Id)-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#ticket-status-@(status.Id)"
                        type="button"
                        role="tab"
                        aria-controls="ticket-status-@(status.Id)"
                        aria-selected="@(index == 0 ? "true" : "false")">
                    <span>@status.TitleFa</span>
                    <small>@count</small>
                </button>
            </li>
        }
    </ul>

    <div class="tab-content support-status-tab-content">
        @for (var index = 0; index < Model.StatusTabs.Count; index++)
        {
            var status = Model.StatusTabs[index];
            var statusTickets = Model.TicketsFor(status.Id);
            <div class="tab-pane fade @(index == 0 ? "show active" : string.Empty)"
                 id="ticket-status-@(status.Id)"
                 role="tabpanel"
                 aria-labelledby="ticket-status-@(status.Id)-tab">
                <div class="table-responsive">
                    <table class="table align-middle support-ticket-table">
                        <thead>
                            <tr>
                                <th>تیکت</th>
                                <th>ثبت کننده</th>
                                <th>نوع</th>
                                <th>گیرنده</th>
                                <th>مسئول</th>
                                <th>آخرین تغییر</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in statusTickets)
                            {
                                <tr>
                                    <td><div class="fw-semibold">@item.Title</div><div class="text-muted small">#@item.Id</div></td>
                                    <td><div>@item.SubmitterDisplayName</div><div class="text-muted small">@SupportTicketUiFormatter.FormatRole(item.SubmitterRole)</div></td>
                                    <td>@item.TicketTypeTitleFa</td>
                                    <td>@item.TicketRecipientTypeTitleFa</td>
                                    <td>@(item.AssignedSupportDisplayName ?? item.RecipientPlannerDisplayName ?? "بدون مسئول")</td>
                                    <td>@PersianDateFormatter.FormatDateTime(item.UpdatedAt ?? item.CreatedAt, true)</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" asp-page="/Support/Details" asp-route-id="@item.Id">
                                            <i class="bi @TicketsModel.ActionIcon(status.Id)"></i>
                                            @TicketsModel.ActionLabel(status.Id)
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (statusTickets.Count == 0)
                {
                    <div class="empty-state">تیکتی با وضعیت @status.TitleFa پیدا نشد.</div>
                }
            </div>
        }
    </div>
    @if (Model.Tickets.Count == 0)
    {
        <div class="empty-state">تیکتی با این فیلترها پیدا نشد.</div>
    }
</div>
