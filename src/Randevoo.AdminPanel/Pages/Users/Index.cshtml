@page "{id?}"
@model Randevoo.AdminPanel.Pages.Users.IndexModel
@{
    ViewData["Title"] = "کاربران";
}

<section class="page-header">
    <div>
        <h1>کاربران</h1>
        <p>ایجاد و ویرایش مدیرها و برگزارکننده ها از یک نقطه کنترل واقعی روی داده های پایگاه داده.</p>
    </div>
</section>

<div class="row g-4">
    <div class="col-lg-4">
        <form method="post" class="glass-panel p-4 sticky-panel">
            <input type="hidden" asp-for="UserId" />
            <h2 class="section-title">@((Model.UserId is null) ? "ایجاد کاربر" : "ویرایش کاربر")</h2>

            <div class="mb-3">
                <label asp-for="Input.FullName" class="form-label">نام کامل</label>
                <input asp-for="Input.FullName" class="form-control" />
                <div class="help-tip">نامی را وارد کنید که در لیست ها و گزارش ها برای تیم نمایش داده می شود.</div>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Mobile" class="form-label">موبایل</label>
                <input asp-for="Input.Mobile" class="form-control" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" />
                <div class="help-tip">شماره موبایل برای ورود و پیگیری اعلان های کاربر استفاده می شود.</div>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Role" class="form-label">نقش</label>
                <select asp-for="Input.Role" class="form-select" asp-items="Model.RoleOptions"></select>
                <div class="help-tip">برای دسترسی کمتر، نقش محدودتر را انتخاب کنید تا منوها ساده تر بمانند.</div>
            </div>
            <div class="form-check form-switch mb-3">
                <input asp-for="Input.IsActive" class="form-check-input" />
                <label asp-for="Input.IsActive" class="form-check-label">فعال</label>
            </div>
            <button type="submit" class="btn btn-primary w-100">ذخیره کاربر</button>
        </form>
    </div>

    <div class="col-lg-8">
        <div class="glass-panel p-4">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>نام</th>
                            <th>موبایل</th>
                            <th>نقش</th>
                            <th>وضعیت</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td dir="ltr">@user.Mobile</td>
                                <td>@DisplayFormatter.Role(user.Role)</td>
                                <td><span class="status-badge @(user.IsActive ? "status-approved" : "status-rejected")">@(user.IsActive ? "فعال" : "غیرفعال")</span></td>
                                <td class="text-end table-action-cell">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle table-action-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            عملیات
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end action-menu shadow-sm border-0">
                                            <a asp-page="/Users/Index" asp-route-id="@user.Id" class="dropdown-item">
                                                <i class="bi bi-pencil-square"></i>ویرایش کاربر
                                            </a>
                                            @if (user.Role == Randevoo.AdminPanel.Models.Auth.AdminRole.EventPlanner)
                                            {
                                                <a asp-page="/Planner/BankAccounts" asp-route-plannerUserId="@user.Id" class="dropdown-item">
                                                    <i class="bi bi-bank2"></i>حساب های بانکی
                                                </a>
                                                <a asp-page="/Planner/Details" asp-route-id="@user.Id" class="dropdown-item">
                                                    <i class="bi bi-person-vcard"></i>پروفایل برگزارکننده
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
