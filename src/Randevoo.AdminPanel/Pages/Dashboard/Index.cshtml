@page
@model Randevoo.AdminPanel.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "داشبورد مدیریت";
}

<section class="page-header">
    <div>
        <h1>داشبورد مدیریت</h1>
        <p>نمای کلی تاییدها، وضعیت رویدادهای فعال و جریان کاری تیم.</p>
    </div>
</section>

<section class="stats-grid">
    <div class="stat-card glass-panel">
        <div class="stat-label">کل کاربران</div>
        <div class="stat-value">@DisplayFormatter.Count(Model.Stats.UsersCount)</div>
    </div>
    <div class="stat-card glass-panel">
        <div class="stat-label">برگزارکننده ها</div>
        <div class="stat-value">@DisplayFormatter.Count(Model.Stats.PlannerCount)</div>
    </div>
    <div class="stat-card glass-panel">
        <div class="stat-label">در انتظار تایید</div>
        <div class="stat-value">@DisplayFormatter.Count(Model.Stats.PendingEventsCount)</div>
    </div>
    <div class="stat-card glass-panel">
        <div class="stat-label">رویدادهای فعال</div>
        <div class="stat-value">@DisplayFormatter.Count(Model.Stats.LiveEventsCount)</div>
    </div>
</section>

<div class="row g-4 mt-1">
    <div class="col-lg-8">
        <div class="glass-panel p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="section-title mb-0">آخرین رویدادها</h2>
                <a asp-page="/Events/Index" class="btn btn-sm btn-outline-primary">مشاهده همه</a>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>رویداد</th>
                            <th>برگزارکننده</th>
                            <th>وضعیت رویداد</th>
                            <th>بررسی مدیر</th>
                            <th>قیمت</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Events)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.DisplayTitle</div>
                                    <div class="text-muted small">@item.ActiveDraft.City، @item.ActiveDraft.Country</div>
                                </td>
                                <td>@item.PlannerName</td>
                                <td><span class="status-badge @Model.GetOperationalStatusClass(item.OperationalStatus)">@DisplayFormatter.OperationalStatus(item.OperationalStatus)</span></td>
                                <td><span class="status-badge @Model.GetReviewStatusClass(item.ReviewStatus)">@DisplayFormatter.ReviewStatus(item.ReviewStatus)</span></td>
                                <td>@DisplayFormatter.Money(Math.Min(item.ActiveDraft.MaleTicketPrice, item.ActiveDraft.FemaleTicketPrice), Model.IsRtl)</td>
                                <td class="text-end">
                                    <a asp-page="/Events/Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">بررسی</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="glass-panel p-4 mb-4">
            <h2 class="section-title">برآورد فروش</h2>
            <div class="display-6 fw-bold">@DisplayFormatter.Money(Model.Stats.TotalTicketSales, Model.IsRtl)</div>
            <p class="text-muted mb-0">تخمین ارزش فروش بر پایه ظرفیت رویدادهای فعال.</p>
        </div>

        <div class="glass-panel p-4">
            <h2 class="section-title">درآمد معطل تایید</h2>
            <div class="display-6 fw-bold">@DisplayFormatter.Money(Model.Stats.PendingRevenue, Model.IsRtl)</div>
            <p class="text-muted mb-0">تا زمان تصمیم نهایی مدیر آزاد نمی شود.</p>
        </div>
    </div>
</div>
