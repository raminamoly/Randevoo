@page
@model Randevoo.AdminPanel.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p>Overview of approval workload, live events, and user activity.</p>
    </div>
</section>

<section class="stats-grid">
    <div class="stat-card glass-panel">
        <div class="stat-label">Users</div>
        <div class="stat-value">@Model.Stats.UsersCount</div>
    </div>
    <div class="stat-card glass-panel">
        <div class="stat-label">Planners</div>
        <div class="stat-value">@Model.Stats.PlannerCount</div>
    </div>
    <div class="stat-card glass-panel">
        <div class="stat-label">Pending approvals</div>
        <div class="stat-value">@Model.Stats.PendingEventsCount</div>
    </div>
    <div class="stat-card glass-panel">
        <div class="stat-label">Live events</div>
        <div class="stat-value">@Model.Stats.LiveEventsCount</div>
    </div>
</section>

<div class="row g-4 mt-1">
    <div class="col-lg-8">
        <div class="glass-panel p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="section-title mb-0">Latest events</h2>
                <a asp-page="/Events/Index" class="btn btn-sm btn-outline-primary">Open events</a>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Planner</th>
                            <th>Status</th>
                            <th>Price</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Events)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.DisplayTitle</div>
                                    <div class="text-muted small">@item.ActiveDraft.City, @item.ActiveDraft.Country</div>
                                </td>
                                <td>@item.PlannerName</td>
                                <td><span class="status-badge @Model.GetStatusClass(item.Status)">@item.Status</span></td>
                                <td>@DisplayFormatter.Money(item.ActiveDraft.TicketPrice, Model.IsRtl)</td>
                                <td class="text-end">
                                    <a asp-page="/Events/Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Review</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="glass-panel p-4 mb-4">
            <h2 class="section-title">Revenue snapshot</h2>
            <div class="display-6 fw-bold">@DisplayFormatter.Money(Model.Stats.TotalTicketSales, Model.IsRtl)</div>
            <p class="text-muted mb-0">Estimated value based on current live event capacity.</p>
        </div>

        <div class="glass-panel p-4">
            <h2 class="section-title">Pending revenue</h2>
            <div class="display-6 fw-bold">@DisplayFormatter.Money(Model.Stats.PendingRevenue, Model.IsRtl)</div>
            <p class="text-muted mb-0">Locked until admin approval.</p>
        </div>
    </div>
</div>

