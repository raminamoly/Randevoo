@page
@model Randevoo.AdminPanel.Pages.Dashboard.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "داشبورد مدیریت";
}

<section class="page-header dashboard-command-header">
    <div>
        <h1>داشبورد مدیریت</h1>
    </div>
    <div class="dashboard-live-pill">
        <i class="bi bi-activity"></i>
        <span>@DisplayFormatter.Count(Model.Stats.OnlineUsersCount) شرکت‌کننده آنلاین</span>
    </div>
</section>

<section class="dashboard-command-grid">
    <article class="dashboard-hero-card glass-panel">
        <div class="dashboard-hero-content">
            <span class="dashboard-hero-label">فروش کل معادل ریالی</span>
            <strong>@DisplayFormatter.ReportingMoney(Model.Stats.TotalTicketSales, Model.IsRtl)</strong>
        </div>
        <div class="dashboard-hero-orbit">
            <span>@DisplayFormatter.Count(Model.Stats.TicketsSoldCount)</span>
            <small>بلیت فروخته شده</small>
        </div>
    </article>

    <article class="dashboard-kpi-card glass-panel accent-blue">
        <i class="bi bi-people"></i>
        <div>
            <span>کل شرکت‌کنندگان</span>
            <strong>@DisplayFormatter.Count(Model.Stats.UsersCount)</strong>
        </div>
    </article>
    <article class="dashboard-kpi-card glass-panel accent-pink">
        <i class="bi bi-person-workspace"></i>
        <div>
            <span>برگزارکننده ها</span>
            <strong>@DisplayFormatter.Count(Model.Stats.PlannerCount)</strong>
        </div>
    </article>
    <article class="dashboard-kpi-card glass-panel accent-green">
        <i class="bi bi-calendar2-check"></i>
        <div>
            <span>در حال فروش</span>
            <strong>@DisplayFormatter.Count(Model.Stats.LiveEventsCount)</strong>
        </div>
    </article>
    <article class="dashboard-kpi-card glass-panel accent-gold">
        <i class="bi bi-hourglass-split"></i>
        <div>
            <span>پیش نویس فعال</span>
            <strong>@DisplayFormatter.Count(Model.Stats.PendingEventsCount)</strong>
        </div>
    </article>
</section>

<section class="dashboard-main-layout">
    <article class="glass-panel dashboard-chart-card dashboard-wide-chart p-4">
        <div class="dashboard-card-heading">
            <div>
                <h2 class="section-title mb-0">روند درآمد و ایجاد رویداد</h2>
            </div>
            <span class="dashboard-soft-stat">@DisplayFormatter.ReportingMoney(Model.Stats.PendingRevenue, Model.IsRtl) درآمد در جریان</span>
        </div>
        <canvas id="revenueTrendChart" height="120"></canvas>
    </article>

    <article class="glass-panel dashboard-chart-card dashboard-status-card p-4">
        <div class="dashboard-card-heading">
            <div>
                <h2 class="section-title mb-0">وضعیت عملیاتی</h2>
            </div>
        </div>
        <canvas id="eventStatusChart" height="120"></canvas>
    </article>
</section>

<section class="dashboard-map-layout">
    <article class="glass-panel dashboard-map-card">
        <div class="dashboard-card-heading">
            <div>
                <h2 class="section-title mb-0">پراکندگی مکانی رویدادها</h2>
            </div>
            <span class="dashboard-soft-stat">@DisplayFormatter.Count(Model.Stats.LocationPoints.Count) شهر فعال</span>
        </div>
        <div class="dashboard-map-canvas" aria-label="نقشه رویدادها بر اساس شهر">
            <div class="dashboard-map-grid"></div>
            @foreach (var point in Model.Stats.LocationPoints)
            {
                <button type="button" class="dashboard-map-marker" style="@Model.GetMapMarkerStyle(point)" data-city="@point.City" data-events="@DisplayFormatter.Count(point.EventCount)" data-revenue="@DisplayFormatter.ReportingMoney(point.Revenue, Model.IsRtl)">
                    <span></span>
                    <strong>@DisplayFormatter.Count(point.EventCount)</strong>
                </button>
            }
            <div class="dashboard-map-tooltip" id="dashboardMapTooltip"></div>
        </div>
    </article>

    <article class="glass-panel dashboard-location-list p-4">
        <div class="dashboard-card-heading">
            <div>
                <h2 class="section-title mb-0">عملکرد مکانی</h2>
            </div>
        </div>
        <div class="dashboard-ranking-list">
            @foreach (var point in Model.Stats.LocationPoints.Take(6))
            {
                <div class="dashboard-location-row">
                    <div>
                        <strong>@point.City</strong>
                        <span>@point.Country</span>
                    </div>
                    <div>
                        <b>@DisplayFormatter.Count(point.EventCount)</b>
                        <small>@DisplayFormatter.Count(point.TicketCount) بلیت</small>
                    </div>
                </div>
            }
        </div>
    </article>
</section>

<section class="dashboard-chart-grid mt-4">
    <article class="glass-panel dashboard-chart-card p-4">
        <div class="section-title">رویدادها بر اساس نوع</div>
        <canvas id="eventTypeChart" height="120"></canvas>
    </article>
    <article class="glass-panel dashboard-chart-card p-4">
        <div class="section-title">ایجاد رویداد در زمان</div>
        <canvas id="eventCreatedChart" height="120"></canvas>
    </article>
</section>

<section class="glass-panel p-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 gap-3 flex-wrap">
        <h2 class="section-title mb-0">آخرین رویدادها</h2>
        <a asp-page="/Events/Index" class="btn btn-sm btn-outline-primary">مشاهده همه</a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>رویداد</th>
                    <th>برگزارکننده</th>
                    <th>وضعیت رویداد</th>
                    <th>بررسی مدیر</th>
                    <th>قیمت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Events)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.DisplayTitle</div>
                            <div class="text-muted small">@item.ActiveDraft.City، @item.ActiveDraft.Country</div>
                        </td>
                        <td>@item.PlannerName</td>
                        <td><span class="status-badge @Model.GetOperationalStatusClass(item.OperationalStatus)">@DisplayFormatter.OperationalStatus(item.OperationalStatus)</span></td>
                        <td><span class="status-badge @Model.GetReviewStatusClass(item.ReviewStatus)">@DisplayFormatter.ReviewStatus(item.ReviewStatus)</span></td>
                        <td>@DisplayFormatter.TicketMoney(item.ActiveDraft.LowestTicketPrice, item.ActiveDraft.LowestTicketCurrencyCode, Model.IsRtl)</td>
                        <td class="text-end">
                            <a asp-page="/Events/Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">بررسی</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
    <script>
        (() => {
            const revenueTrend = @Html.Raw(JsonSerializer.Serialize(Model.Stats.RevenueTrend.Select(item => new { label = item.Label, value = item.Value })));
            const eventCreatedTrend = @Html.Raw(JsonSerializer.Serialize(Model.Stats.EventCreatedTrend.Select(item => new { label = item.Label, value = item.Value })));
            const eventStatus = @Html.Raw(JsonSerializer.Serialize(Model.Stats.EventStatusBreakdown.Select(item => new { label = item.Label, value = item.Value })));
            const eventTypes = @Html.Raw(JsonSerializer.Serialize(Model.Stats.EventTypeBreakdown.Select(item => new { label = item.Label, value = item.Value })));

            RandevooCharts.line("revenueTrendChart", revenueTrend, { color: "#1765ff" });
            RandevooCharts.bar("eventCreatedChart", eventCreatedTrend, { color: "#22b573" });
            RandevooCharts.doughnut("eventStatusChart", eventStatus, { cutout: "58%" });
            RandevooCharts.doughnut("eventTypeChart", eventTypes);

            const tooltip = document.getElementById("dashboardMapTooltip");
            document.querySelectorAll(".dashboard-map-marker").forEach((marker) => {
                marker.addEventListener("mouseenter", () => {
                    tooltip.innerHTML = `<strong>${marker.dataset.city}</strong><span>${marker.dataset.events} رویداد</span><span>${marker.dataset.revenue}</span>`;
                    tooltip.style.setProperty("--x", marker.style.getPropertyValue("--x"));
                    tooltip.style.setProperty("--y", marker.style.getPropertyValue("--y"));
                    tooltip.classList.add("is-visible");
                });
                marker.addEventListener("mouseleave", () => tooltip.classList.remove("is-visible"));
            });
        })();
    </script>
}
