@page
@model Randevoo.AdminPanel.Pages.Dashboard.MyModel
@{
    ViewData["Title"] = "داشبورد برگزارکننده";
}

<section class="page-header">
    <div>
        <h1>داشبورد برگزارکننده</h1>
    </div>
</section>

<section class="stats-grid">
    <div class="stat-card glass-panel">
        <div class="stat-label">رویدادهای من</div>
        <div class="stat-value">@DisplayFormatter.Count(Model.Stats.MyEventsCount)</div>
    </div>
    <div class="stat-card glass-panel">
        <div class="stat-label">در انتظار بررسی</div>
        <div class="stat-value">@DisplayFormatter.Count(Model.Stats.PendingEventsCount)</div>
    </div>
    <div class="stat-card glass-panel">
        <div class="stat-label">رویدادهای فعال</div>
        <div class="stat-value">@DisplayFormatter.Count(Model.Stats.LiveEventsCount)</div>
    </div>
    <div class="stat-card glass-panel">
        <div class="stat-label">درآمد معطل تایید</div>
        <div class="stat-value">@DisplayFormatter.Money(Model.Stats.PendingRevenue, Model.IsRtl)</div>
    </div>
</section>

<div class="glass-panel p-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-title mb-0">فهرست رویدادهای شما</h2>
        <a asp-page="/Events/Edit" class="btn btn-primary btn-sm">ساخت رویداد</a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>رویداد</th>
                    <th>زمان شروع</th>
                    <th>وضعیت رویداد</th>
                    <th>بررسی مدیر</th>
                    <th>یادداشت مدیر</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Events)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.DisplayTitle</div>
                            <div class="text-muted small">@item.ActiveDraft.City</div>
                        </td>
                        <td>@PersianDateFormatter.Format(item.ActiveDraft.StartAtUtc, Model.IsRtl)</td>
                        <td><span class="status-badge @Model.GetOperationalStatusClass(item.OperationalStatus)">@DisplayFormatter.OperationalStatus(item.OperationalStatus)</span></td>
                        <td><span class="status-badge @Model.GetReviewStatusClass(item.ReviewStatus)">@DisplayFormatter.ReviewStatus(item.ReviewStatus)</span></td>
                        <td class="text-muted">@item.AdminReviewNote</td>
                        <td class="text-end">
                            <a asp-page="/Events/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">ویرایش</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
