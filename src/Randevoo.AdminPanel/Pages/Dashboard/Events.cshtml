@page
@model Randevoo.AdminPanel.Pages.Dashboard.EventsModel
@using System.Text.Json
@{
    ViewData["Title"] = "داشبورد رویدادها";
}

<partial name="_DashboardRangeFilter" model="Model.FilterModel" />

<section class="stats-grid dashboard-metrics-grid">
    @foreach (var metric in Model.Report.Metrics)
    {
        <article class="stat-card glass-panel">
            <div class="stat-label">@metric.Label</div>
            <div class="stat-value">@metric.Value</div>
        </article>
    }
</section>

<section class="dashboard-chart-grid">
    <article class="glass-panel p-4">
        <div class="section-title">ایجاد رویداد در زمان</div>
        <canvas id="createdTrendChart" height="120"></canvas>
    </article>
    <article class="glass-panel p-4">
        <div class="section-title">رویدادها بر اساس نوع</div>
        <canvas id="eventsByTypeChart" height="120"></canvas>
    </article>
    <article class="glass-panel p-4">
        <div class="section-title">رویدادها بر اساس شهر</div>
        <canvas id="eventsByCityChart" height="120"></canvas>
    </article>
    <article class="glass-panel p-4">
        <div class="section-title">رویدادها بر اساس وضعیت</div>
        <canvas id="eventsByStatusChart" height="120"></canvas>
    </article>
</section>

<section class="glass-panel p-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-title mb-0">برگزارکنندگان فعال</h2>
        <span class="text-muted small">@Model.Range.Label</span>
    </div>
    <div class="dashboard-ranking-list">
        @foreach (var item in Model.Report.TopPlanners)
        {
            <div class="dashboard-ranking-item">
                <div>
                    <strong>@item.Label</strong>
                    <div class="text-muted small">@item.Meta</div>
                </div>
                <span>@item.Value.ToString("N0")</span>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
    <script>
        (() => {
            const palette = ["#1765ff", "#ff3c72", "#f4a621", "#0f1f4d", "#22b573", "#ef6c00", "#607d8b", "#8e24aa"];
            const pie = (canvasId, slices) => {
                const canvas = document.getElementById(canvasId);
                if (!canvas || slices.length === 0) {
                    return;
                }

                new Chart(canvas, {
                    type: "pie",
                    data: {
                        labels: slices.map(item => item.label),
                        datasets: [{
                            data: slices.map(item => item.value),
                            backgroundColor: palette
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            };

            const line = (canvasId, points) => {
                const canvas = document.getElementById(canvasId);
                if (!canvas || points.length === 0) {
                    return;
                }

                new Chart(canvas, {
                    type: "line",
                    data: {
                        labels: points.map(item => item.label),
                        datasets: [{
                            data: points.map(item => item.value),
                            borderColor: "#1765ff",
                            backgroundColor: "#1765ff22",
                            fill: true,
                            tension: 0.35
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } }
                    }
                });
            };

            line("createdTrendChart", @Html.Raw(JsonSerializer.Serialize(Model.Report.CreatedTrend.Select(item => new { label = item.Label, value = item.Value }))));
            pie("eventsByTypeChart", @Html.Raw(JsonSerializer.Serialize(Model.Report.EventsByType.Select(item => new { label = item.Label, value = item.Value }))));
            pie("eventsByCityChart", @Html.Raw(JsonSerializer.Serialize(Model.Report.EventsByCity.Select(item => new { label = item.Label, value = item.Value }))));
            pie("eventsByStatusChart", @Html.Raw(JsonSerializer.Serialize(Model.Report.EventsByStatus.Select(item => new { label = item.Label, value = item.Value }))));
        })();
    </script>
}
