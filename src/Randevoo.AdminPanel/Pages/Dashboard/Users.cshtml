@page
@model Randevoo.AdminPanel.Pages.Dashboard.UsersModel
@using System.Text.Json
@{
    ViewData["Title"] = "داشبورد شرکت‌کنندگان";
}

<partial name="_DashboardRangeFilter" model="Model.FilterModel" />

<section class="stats-grid dashboard-metrics-grid">
    @foreach (var metric in Model.Report.Metrics)
    {
        <article class="stat-card glass-panel">
            <div class="stat-label">@metric.Label</div>
            <div class="stat-value">@metric.Value</div>
            @if (!string.IsNullOrWhiteSpace(metric.Hint))
            {
                <div class="stat-hint">@metric.Hint</div>
            }
        </article>
    }
</section>

<section class="dashboard-chart-grid">
    <article class="glass-panel dashboard-chart-card p-4">
        <div class="section-title">ثبت نام شرکت‌کنندگان</div>
        <canvas id="signupTrendChart" height="110"></canvas>
    </article>
    <article class="glass-panel dashboard-chart-card p-4">
        <div class="section-title">شرکت‌کنندگان فعال روزانه</div>
        <canvas id="activeUsersChart" height="110"></canvas>
    </article>
    <article class="glass-panel dashboard-chart-card p-4">
        <div class="section-title">زمان حضور</div>
        <canvas id="timeSpentChart" height="110"></canvas>
    </article>
    <article class="glass-panel dashboard-chart-card p-4">
        <div class="section-title">تعداد کلیک</div>
        <canvas id="clickTrendChart" height="110"></canvas>
    </article>
</section>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
    <script>
        (() => {
            RandevooCharts.line("signupTrendChart", @Html.Raw(JsonSerializer.Serialize(Model.Report.SignupTrend.Select(item => new { label = item.Label, value = item.Value }))), { color: "#1765ff" });
            RandevooCharts.line("activeUsersChart", @Html.Raw(JsonSerializer.Serialize(Model.Report.DailyActiveUsers.Select(item => new { label = item.Label, value = item.Value }))), { color: "#ff3c72" });
            RandevooCharts.line("timeSpentChart", @Html.Raw(JsonSerializer.Serialize(Model.Report.TimeSpentTrend.Select(item => new { label = item.Label, value = item.Value }))), { color: "#f4a621" });
            RandevooCharts.line("clickTrendChart", @Html.Raw(JsonSerializer.Serialize(Model.Report.ClickTrend.Select(item => new { label = item.Label, value = item.Value }))), { color: "#0f1f4d" });
        })();
    </script>
}
