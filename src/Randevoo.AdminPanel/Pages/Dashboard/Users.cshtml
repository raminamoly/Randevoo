@page
@model Randevoo.AdminPanel.Pages.Dashboard.UsersModel
@using System.Text.Json
@{
    ViewData["Title"] = "داشبورد کاربران";
}

<partial name="_DashboardRangeFilter" model="Model.FilterModel" />

<section class="stats-grid dashboard-metrics-grid">
    @foreach (var metric in Model.Report.Metrics)
    {
        <article class="stat-card glass-panel">
            <div class="stat-label">@metric.Label</div>
            <div class="stat-value">@metric.Value</div>
            @if (!string.IsNullOrWhiteSpace(metric.Hint))
            {
                <div class="stat-hint">@metric.Hint</div>
            }
        </article>
    }
</section>

<section class="dashboard-chart-grid">
    <article class="glass-panel p-4">
        <div class="section-title">ثبت نام کاربران</div>
        <canvas id="signupTrendChart" height="110"></canvas>
    </article>
    <article class="glass-panel p-4">
        <div class="section-title">کاربران فعال روزانه</div>
        <canvas id="activeUsersChart" height="110"></canvas>
    </article>
    <article class="glass-panel p-4">
        <div class="section-title">زمان حضور</div>
        <canvas id="timeSpentChart" height="110"></canvas>
    </article>
    <article class="glass-panel p-4">
        <div class="section-title">تعداد کلیک</div>
        <canvas id="clickTrendChart" height="110"></canvas>
    </article>
</section>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
    <script>
        (() => {
            const lineColor = "#1765ff";
            const accentColor = "#ff3c72";
            const goldColor = "#f4a621";
            const buildLine = (canvasId, points, color) => {
                const canvas = document.getElementById(canvasId);
                if (!canvas || points.length === 0) {
                    return;
                }

                new Chart(canvas, {
                    type: "line",
                    data: {
                        labels: points.map(item => item.label),
                        datasets: [{
                            data: points.map(item => item.value),
                            borderColor: color,
                            backgroundColor: color + "22",
                            tension: 0.35,
                            fill: true,
                            pointRadius: 3
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } }
                    }
                });
            };

            buildLine("signupTrendChart", @Html.Raw(JsonSerializer.Serialize(Model.Report.SignupTrend.Select(item => new { label = item.Label, value = item.Value }))), lineColor);
            buildLine("activeUsersChart", @Html.Raw(JsonSerializer.Serialize(Model.Report.DailyActiveUsers.Select(item => new { label = item.Label, value = item.Value }))), accentColor);
            buildLine("timeSpentChart", @Html.Raw(JsonSerializer.Serialize(Model.Report.TimeSpentTrend.Select(item => new { label = item.Label, value = item.Value }))), goldColor);
            buildLine("clickTrendChart", @Html.Raw(JsonSerializer.Serialize(Model.Report.ClickTrend.Select(item => new { label = item.Label, value = item.Value }))), "#0f1f4d");
        })();
    </script>
}
