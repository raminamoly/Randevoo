@page "{id?}"
@model Randevoo.AdminPanel.Pages.Tags.IndexModel
@{
    ViewData["Title"] = "تگ های رویداد";
    var editorExpanded = Model.IsEditing || !ViewData.ModelState.IsValid;
    var editorCollapseId = "tagEditorPanel";
}

<section class="page-header">
    <div>
        <h1>تگ های رویداد</h1>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info border-0 mb-4">@Model.StatusMessage</div>
}

<div class="settings-editor-stack">
    <section class="glass-panel base-data-editor-shell">
        <div class="base-data-editor-bar">
            <div>
                <span class="base-data-editor-kicker">پنل ایجاد و ویرایش</span>
                <h2 class="section-title mb-0">@((Model.IsEditing) ? "ویرایش تگ" : "ایجاد تگ")</h2>
            </div>
            <button class="btn btn-primary base-data-editor-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#@editorCollapseId"
                    aria-expanded="@(editorExpanded.ToString().ToLowerInvariant())"
                    aria-controls="@editorCollapseId">
                <i class="bi @(Model.IsEditing ? "bi-pencil-square" : "bi-plus-lg")"></i>
                <span>@(Model.IsEditing ? "نمایش فرم ویرایش" : "افزودن تگ")</span>
            </button>
        </div>

        <div id="@editorCollapseId" class="collapse @(editorExpanded ? "show" : string.Empty)">
            <div class="base-data-editor-body">
                <form method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-3"></div>

                    <div class="row g-3 align-items-end">
                        <div class="col-lg-5">
                            <label asp-for="Input.Name" class="form-label">نام</label>
                            <input asp-for="Input.Name" class="form-control" />
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            <div class="help-tip">این نام در فرم ساخت و ویرایش رویداد نمایش داده می شود.</div>
                        </div>

                        <div class="col-lg-3">
                            <div class="form-check form-switch settings-editor-switch">
                                <input asp-for="Input.IsActive" class="form-check-input" />
                                <label asp-for="Input.IsActive" class="form-check-label">فعال</label>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                                <button type="submit" class="btn btn-primary">ذخیره تگ</button>
                                @if (Model.IsEditing)
                                {
                                    <a asp-page="/Tags/Index" class="btn btn-outline-secondary">ثبت تگ جدید</a>
                                }
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <section class="glass-panel p-4">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>نام</th>
                        <th>وضعیت</th>
                        <th>تعداد استفاده</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Tags)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td><span class="status-badge @(item.IsActive ? "status-approved" : "status-closed")">@(item.IsActive ? "فعال" : "غیرفعال")</span></td>
                            <td>@DisplayFormatter.Count(item.EventUsageCount)</td>
                            <td class="text-end table-action-cell">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle table-action-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        عملیات
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end action-menu shadow-sm border-0">
                                        <a asp-page="/Tags/Index" asp-route-id="@item.Id" class="dropdown-item">
                                            <i class="bi bi-pencil-square"></i>ویرایش تگ
                                        </a>
                                        @if (item.EventUsageCount > 0)
                                        {
                                            <button class="dropdown-item disabled text-muted" type="button" aria-disabled="true" title="این تگ در رویدادها استفاده شده است و قابل حذف نیست.">
                                                <i class="bi bi-lock"></i>حذف غیرفعال است
                                            </button>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('تگ حذف شود؟');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button class="dropdown-item text-danger" type="submit">
                                                    <i class="bi bi-trash3"></i>حذف تگ
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<partial name="_ValidationScriptsPartial" />
