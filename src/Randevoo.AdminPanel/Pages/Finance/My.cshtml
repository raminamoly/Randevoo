@page
@model Randevoo.AdminPanel.Pages.Finance.MyModel
@{
    ViewData["Title"] = "مالی من";
}

<section class="page-header">
    <div>
        <h1>مالی من</h1>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success border-0 mb-4">@Model.StatusMessage</div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-4"></div>

<section class="stats-grid">
    <div class="stat-card glass-panel">
        <div class="stat-label">درآمد کل ریالی</div>
        <div class="stat-value">@DisplayFormatter.ReportingMoney(Model.Finance.TotalCommissionIncomeIrr, Model.IsRtl)</div>
    </div>
    <div class="stat-card glass-panel">
        <div class="stat-label">قابل برداشت</div>
        <div class="stat-value">@DisplayFormatter.ReportingMoney(Model.Finance.AvailableWithdrawalAmount, Model.IsRtl)</div>
    </div>
    <div class="stat-card glass-panel">
        <div class="stat-label">در انتظار تسویه</div>
        <div class="stat-value">@DisplayFormatter.ReportingMoney(Model.Finance.PendingWithdrawalAmount, Model.IsRtl)</div>
    </div>
</section>

<section class="glass-panel p-4 mt-4">
    <ul class="nav nav-pills mb-4 finance-tab-nav" id="plannerFinanceTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="finance-events-tab" data-bs-toggle="pill" data-bs-target="#finance-events-pane" type="button" role="tab" aria-controls="finance-events-pane" aria-selected="true">درآمد رویدادها</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="finance-transactions-tab" data-bs-toggle="pill" data-bs-target="#finance-transactions-pane" type="button" role="tab" aria-controls="finance-transactions-pane" aria-selected="false">تراکنش‌های کمیسیون</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="finance-withdrawals-tab" data-bs-toggle="pill" data-bs-target="#finance-withdrawals-pane" type="button" role="tab" aria-controls="finance-withdrawals-pane" aria-selected="false">درخواست تسویه</button>
        </li>
    </ul>

    <div class="tab-content" id="plannerFinanceTabsContent">
        <div class="tab-pane fade show active" id="finance-events-pane" role="tabpanel" aria-labelledby="finance-events-tab" tabindex="0">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>رویداد</th>
                            <th>زمان شروع</th>
                            <th>بلیت فروش رفته</th>
                            <th>فروش کل</th>
                            <th>سهم شما</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Finance.Events)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.EventTitle</div>
                                    <div class="text-muted small">کمیسیون برگزارکننده: @DisplayFormatter.Percent(item.PlannerCommissionPercent)</div>
                                </td>
                                <td>@PersianDateFormatter.Format(item.StartAtUtc, Model.IsRtl)</td>
                                <td>@DisplayFormatter.Count(item.TicketsSold)</td>
                                <td>
                                    <div>@DisplayFormatter.CurrencyMoney(item.GrossTicketSales, item.CurrencyCode, Model.IsRtl)</div>
                                    <div class="text-muted small">@DisplayFormatter.ReportingMoney(item.GrossTicketSalesIrr, Model.IsRtl)</div>
                                </td>
                                <td class="fw-semibold">
                                    <div>@DisplayFormatter.CurrencyMoney(item.PlannerIncome, item.CurrencyCode, Model.IsRtl)</div>
                                    <div class="text-muted small">@DisplayFormatter.ReportingMoney(item.PlannerIncomeIrr, Model.IsRtl)</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Finance.Events.Count == 0)
            {
                <div class="empty-state">هنوز درآمدی برای رویدادهای شما ثبت نشده است.</div>
            }
        </div>

        <div class="tab-pane fade" id="finance-transactions-pane" role="tabpanel" aria-labelledby="finance-transactions-tab" tabindex="0">
            <div class="finance-card-list">
                @foreach (var item in Model.Finance.Transactions)
                {
                    <article class="finance-transaction-card">
                        <div>
                            <div class="fw-semibold">@item.EventTitle</div>
                            <div class="text-muted small">@item.Description</div>
                            <div class="text-muted small">@PersianDateFormatter.FormatDateTime(item.CreatedAtUtc, Model.IsRtl)</div>
                        </div>
                        <div class="text-end">
                            <span class="status-badge @(item.Amount >= 0 ? "status-approved" : "status-closed")">@DisplayFormatter.TransactionType(item.Type)</span>
                            <div class="finance-amount @(item.Amount >= 0 ? "positive" : "negative")">@DisplayFormatter.CurrencyMoney(item.Amount, item.CurrencyCode, Model.IsRtl)</div>
                            <div class="text-muted small">@DisplayFormatter.ReportingMoney(item.ReportingAmountIrr, Model.IsRtl)</div>
                        </div>
                    </article>
                }
            </div>
            @if (Model.Finance.Transactions.Count == 0)
            {
                <div class="empty-state">هنوز تراکنشی برای نمایش وجود ندارد.</div>
            }
        </div>

        <div class="tab-pane fade" id="finance-withdrawals-pane" role="tabpanel" aria-labelledby="finance-withdrawals-tab" tabindex="0">
            <div class="row g-4">
                <div class="col-lg-4">
                    <form method="post" asp-page-handler="RequestWithdrawal" class="glass-panel p-4 sticky-panel">
                        <h2 class="section-title">ثبت درخواست تسویه</h2>
                        <p class="text-muted small">درخواست را با واحد ثبت تسویه فعلی (@Model.Finance.SettlementCurrencyCode) وارد کنید.</p>
                        <div class="mb-3">
                            <label asp-for="Input.Amount" class="form-label">مبلغ برداشت (@Model.Finance.SettlementCurrencyCode)</label>
                            <input asp-for="Input.Amount" class="form-control" type="number" min="0.01" step="0.01" />
                            <span asp-validation-for="Input.Amount" class="text-danger small"></span>
                            <div class="help-tip">حداکثر قابل برداشت: @DisplayFormatter.ReportingMoney(Model.Finance.AvailableWithdrawalAmount, Model.IsRtl)</div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100" disabled="@(Model.Finance.AvailableWithdrawalAmount <= 0)">ثبت درخواست تسویه</button>
                    </form>
                </div>
                <div class="col-lg-8">
                    <div class="finance-card-list compact">
                        @foreach (var item in Model.Finance.Withdrawals)
                        {
                            <article class="finance-withdrawal-card">
                                <div class="d-flex justify-content-between gap-2">
                                    <strong>@DisplayFormatter.CurrencyMoney(item.Amount, item.CurrencyCode, Model.IsRtl)</strong>
                                    <span class="status-badge @Model.WithdrawalStatusClass(item.Status)">@DisplayFormatter.WithdrawalStatus(item.Status)</span>
                                </div>
                                <div class="text-muted small mt-2">ثبت: @PersianDateFormatter.FormatDateTime(item.RequestedAtUtc, Model.IsRtl)</div>
                                <div class="text-muted small">معادل ریالی: @DisplayFormatter.ReportingMoney(item.ReportingAmountIrr, Model.IsRtl)</div>
                                @if (item.ReviewedAtUtc is not null)
                                {
                                    <div class="text-muted small">بررسی: @PersianDateFormatter.FormatDateTime(item.ReviewedAtUtc.Value, Model.IsRtl)</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.ReviewNote))
                                {
                                    <div class="finance-note">@item.ReviewNote</div>
                                }
                            </article>
                        }
                    </div>
                    @if (Model.Finance.Withdrawals.Count == 0)
                    {
                        <div class="empty-state">هنوز درخواست تسویه ای ثبت نشده است.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<partial name="_ValidationScriptsPartial" />
