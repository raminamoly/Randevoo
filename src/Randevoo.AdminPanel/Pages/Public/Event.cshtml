@page "{id:long}"
@model Randevoo.AdminPanel.Pages.Public.EventModel
@{
    ViewData["Title"] = $"{Model.Event.DisplayTitle} {Model.Event.DisplayCode}";
    ViewData["UseShell"] = false;
    var draft = Model.Event.Live;
    var validFaqs = draft.Faqs.Where(item => !string.IsNullOrWhiteSpace(item.Question) && !string.IsNullOrWhiteSpace(item.Answer)).ToList();
}

<main class="public-event-shell public-event-view">
    <nav class="public-event-nav" aria-label="ناوبری رویداد">
        <a asp-page="/Index" class="public-event-brand">
            <img src="~/images/logo.png" alt="راندوو" />
            <span>راندوو</span>
        </a>
        <div class="public-event-nav-meta">
            <span>رویداد @Model.Event.DisplayCode</span>
            <span>@DisplayFormatter.EventTypeLabel(draft.EventTypeName)</span>
            <span>@draft.EventModeName</span>
        </div>
    </nav>

    @if (Model.IsPreviewMode)
    {
        <div class="public-event-preview-note">
            <i class="bi bi-eye"></i>
            این صفحه پیش‌نمایش پنل است و هنوز برای کاربران نهایی منتشر نشده است.
        </div>
    }

    <section class="public-event-hero public-event-final-hero">
        <div class="public-event-hero-copy">
            <div class="public-event-labels">
                <span>@DisplayFormatter.EventTypeLabel(draft.EventTypeName)</span>
                <span>@(draft.IsOnline ? "آنلاین" : draft.City)</span>
            </div>
            <h1>@Model.Event.DisplayTitle</h1>
            <p>@(string.IsNullOrWhiteSpace(draft.VenueName) ? draft.City : draft.VenueName)</p>
            <div class="public-event-hero-facts" aria-label="اطلاعات سریع رویداد">
                <div>
                    <span>شروع</span>
                    <strong>@PersianDateFormatter.Format(draft.StartAtUtc, true)</strong>
                </div>
                <div>
                    <span>برگزاری</span>
                    <strong>@draft.EventModeName</strong>
                </div>
                <div>
                    <span>قیمت از</span>
                    <strong>@DisplayFormatter.TicketMoney(draft.LowestTicketPrice, draft.LowestTicketCurrencyCode, true)</strong>
                </div>
            </div>
        </div>
        <div class="public-event-hero-media">
            @if (Model.EventImages.Count > 0)
            {
                <partial name="_EventImageSlider" model="Model.EventImageCarousel" />
            }
            else
            {
                <div class="public-event-image-placeholder">
                    <i class="bi bi-calendar-heart"></i>
                    <span>@Model.Event.DisplayTitle</span>
                </div>
            }
        </div>
    </section>

    <section class="public-event-summary public-event-final-summary" aria-label="خلاصه رویداد">
        <div class="detail-block"><span>پایان</span><strong>@PersianDateFormatter.Format(draft.EndAtUtc, true)</strong></div>
        <div class="detail-block"><span>شهر</span><strong>@draft.City، @draft.Country</strong></div>
        <div class="detail-block"><span>محدوده سنی آقایان</span><strong>@draft.AgeRangeForMale</strong></div>
        <div class="detail-block"><span>محدوده سنی خانم‌ها</span><strong>@draft.AgeRangeForFemale</strong></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(draft.DescriptionHtml))
    {
        <section class="public-event-section">
            <div class="public-section-head">
                <h2>درباره رویداد</h2>
            </div>
            <div class="rich-text-preview public-event-description">@Html.Raw(draft.DescriptionHtml)</div>
        </section>
    }

    <section class="public-event-section">
        <div class="public-section-head">
            <h2>بلیت و ظرفیت</h2>
        </div>
        <div class="public-ticket-grid">
            <article class="public-ticket-card">
                <div>
                    <span>آقایان</span>
                    <strong>@DisplayFormatter.TicketMoney(draft.MaleTicketPrice, draft.MaleTicketCurrencyCode, true)</strong>
                </div>
                <div class="public-ticket-meta">
                    <span>ظرفیت @DisplayFormatter.Count(draft.CapacityMale)</span>
                    <span>سن @draft.AgeRangeForMale</span>
                </div>
            </article>
            <article class="public-ticket-card">
                <div>
                    <span>خانم‌ها</span>
                    <strong>@DisplayFormatter.TicketMoney(draft.FemaleTicketPrice, draft.FemaleTicketCurrencyCode, true)</strong>
                </div>
                <div class="public-ticket-meta">
                    <span>ظرفیت @DisplayFormatter.Count(draft.CapacityFemale)</span>
                    <span>سن @draft.AgeRangeForFemale</span>
                </div>
            </article>
        </div>
    </section>

    <section class="public-event-section">
        <div class="public-section-head">
            <h2>محل و دسترسی</h2>
        </div>
        <div class="public-location-panel">
            @if (draft.IsOnline)
            {
                <div class="detail-block"><span>پلتفرم</span><strong>@(draft.OnlinePlatformName ?? "آنلاین")</strong></div>
                @if (!string.IsNullOrWhiteSpace(draft.OnlineAccessInstructions))
                {
                    <div class="detail-block"><span>راهنمای ورود</span><strong>@draft.OnlineAccessInstructions</strong></div>
                }
            }
            else
            {
                <div class="detail-block"><span>محل برگزاری</span><strong>@draft.VenueName</strong></div>
                <div class="detail-block"><span>منطقه</span><strong>@draft.Region</strong></div>
                <div class="detail-block public-location-address"><span>آدرس</span><strong>@draft.Address</strong></div>
            }
        </div>
    </section>

    @if (Model.PlannerProfile is not null)
    {
        <section class="public-event-section public-planner-section">
            <div class="public-section-head">
                <h2>برگزارکننده</h2>
            </div>
            <div class="public-planner-card public-planner-card-clean">
                <img src="@Model.PlannerProfile.PictureUrl" alt="@Model.PlannerProfile.FullName" class="planner-avatar" />
                <div>
                    <h3>@Model.PlannerProfile.FullName</h3>
                    <div class="planner-title">@Model.PlannerProfile.Title</div>
                    <p>@Model.PlannerProfile.Resume</p>
                    <div class="planner-metrics">
                        <div class="detail-block"><span>شهر فعالیت</span><strong>@Model.PlannerProfile.City</strong></div>
                        <div class="detail-block"><span>میانگین امتیاز</span><strong>@DisplayFormatter.ToPersianDigits(Model.PlannerProfile.AverageRating.ToString("0.0"))</strong></div>
                        <div class="detail-block"><span>رویداد برگزارشده</span><strong>@DisplayFormatter.Count(Model.PlannerProfile.HostedEventCount)</strong></div>
                    </div>
                </div>
            </div>
        </section>
    }

    @if (validFaqs.Count > 0)
    {
        <section class="public-event-section">
            <div class="public-section-head">
                <h2>سوالات متداول</h2>
            </div>
            <div class="faq-list">
                @foreach (var faq in validFaqs)
                {
                    <article class="faq-card">
                        <h3>@faq.Question</h3>
                        <p>@faq.Answer</p>
                    </article>
                }
            </div>
        </section>
    }
</main>
