@page
@model Randevoo.AdminPanel.Pages.UserProfiles.IndexModel
@{
    ViewData["Title"] = "لیست شرکت کنندگان";
}

<section class="page-header">
    <div>
        <h1>لیست شرکت کنندگان</h1>
    </div>
</section>

<form method="get" class="glass-panel p-4 mb-4 filter-panel">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <h2 class="section-title mb-1">فیلتر شرکت‌کنندگان</h2>
            <p class="text-muted small mb-0">جستجو و فیلترها روی سرور اعمال می شوند تا صفحه روی دیتای سنگین هم سریع بماند.</p>
        </div>
        <button class="btn btn-outline-secondary btn-sm filter-toggle-button" type="button" data-bs-toggle="collapse" data-bs-target="#profileFilterPanel" aria-expanded="@(Model.HasActiveFilters.ToString().ToLowerInvariant())" aria-controls="profileFilterPanel">
            <i class="bi bi-funnel"></i>فیلترها
        </button>
    </div>
    <div id="profileFilterPanel" class="collapse @(Model.HasActiveFilters ? "show" : string.Empty)">
        <input type="hidden" name="PageNumber" value="1" />
        <div class="row g-3 align-items-end">
            <div class="col-lg-3">
                <label asp-for="Search" class="form-label">جستجو</label>
                <input asp-for="Search" class="form-control" placeholder="نام، موبایل یا ایمیل" />
            </div>
            <div class="col-md-2">
                <label asp-for="CityId" class="form-label">شهر</label>
                <select asp-for="CityId" asp-items="Model.CityOptions" class="form-select">
                    <option value="">همه</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="GenderId" class="form-label">جنسیت</label>
                <select asp-for="GenderId" asp-items="Model.GenderOptions" class="form-select">
                    <option value="">همه</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="ZodiacSignId" class="form-label">نشان زودیاک</label>
                <select asp-for="ZodiacSignId" asp-items="Model.ZodiacSignOptions" class="form-select">
                    <option value="">همه</option>
                </select>
            </div>
            <div class="col-md-1">
                <label asp-for="IsActive" class="form-label">فعال</label>
                <select asp-for="IsActive" class="form-select">
                    <option value="">همه</option>
                    <option value="true">بله</option>
                    <option value="false">خیر</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="IsProfileComplete" class="form-label">تکمیل پروفایل</label>
                <select asp-for="IsProfileComplete" class="form-select">
                    <option value="">همه</option>
                    <option value="true">تکمیل شده</option>
                    <option value="false">ناقص</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="Sort" class="form-label">مرتب سازی</label>
                <select asp-for="Sort" class="form-select">
                    <option value="newest">جدیدتر</option>
                    <option value="oldest">قدیمی تر</option>
                    <option value="name">نام</option>
                    <option value="last-activity">آخرین فعالیت</option>
                </select>
            </div>
            <div class="col-12 d-flex justify-content-end">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i>اعمال فیلتر</button>
            </div>
        </div>
    </div>
</form>

<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <h2 class="section-title mb-0">پروفایل ها</h2>
        <span class="text-muted small">@Model.Result.TotalCount.ToString("N0") رکورد</span>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>شرکت‌کننده</th>
                    <th>نقش</th>
                    <th>جنسیت</th>
                    <th>شهر</th>
                    <th>سن</th>
                    <th>زودیاک</th>
                    <th>تحصیلات</th>
                    <th>تکمیل پروفایل</th>
                    <th>فعال</th>
                    <th>ساخته شده</th>
                    <th>آخرین فعالیت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Result.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.DisplayName</div>
                            <div class="text-muted small" dir="ltr">@item.MobileNumber</div>
                        </td>
                        <td>@item.RoleTitle</td>
                        <td>@item.GenderTitle</td>
                        <td>@item.CityTitle</td>
                        <td>@DisplayFormatter.Count(item.Age)</td>
                        <td>@item.ZodiacSignTitle</td>
                        <td>@item.EducationLevelTitle</td>
                        <td>
                            <span class="status-badge @(item.IsProfileComplete ? "status-approved" : "status-pending")">
                                @(item.IsProfileComplete ? "تکمیل شده" : "ناقص")
                            </span>
                        </td>
                        <td>
                            <span class="status-badge @(item.IsActive ? "status-approved" : "status-closed")">
                                @(item.IsActive ? "فعال" : "غیرفعال")
                            </span>
                        </td>
                        <td>@PersianDateFormatter.FormatDateTime(item.CreatedAtUtc, true)</td>
                        <td>@(item.LastActivityAtUtc.HasValue ? PersianDateFormatter.FormatDateTime(item.LastActivityAtUtc.Value, true) : "بدون لاگ")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-page="/UserProfiles/Details" asp-route-userId="@item.UserId" class="btn btn-sm btn-outline-primary">نمایش</a>
                                <a asp-page="/UserProfiles/AdminEdit" asp-route-userId="@item.UserId" class="btn btn-sm btn-outline-secondary">ویرایش</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Result.Items.Count == 0)
    {
        <div class="empty-state">برای فیلتر فعلی شرکت‌کننده‌ای پیدا نشد.</div>
    }

    <nav class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-4">
        <a class="btn btn-outline-secondary @(Model.HasPreviousPage ? string.Empty : "disabled")"
           asp-page="/UserProfiles/Index"
           asp-route-Search="@Model.Search"
           asp-route-CityId="@Model.CityId"
           asp-route-GenderId="@Model.GenderId"
           asp-route-ZodiacSignId="@Model.ZodiacSignId"
           asp-route-IsActive="@Model.IsActive"
           asp-route-IsProfileComplete="@Model.IsProfileComplete"
           asp-route-Sort="@Model.Sort"
           asp-route-PageNumber="@(Model.PageNumber - 1)">قبلی</a>
        <span class="text-muted small">صفحه @Model.PageNumber از @Model.TotalPages</span>
        <a class="btn btn-outline-secondary @(Model.HasNextPage ? string.Empty : "disabled")"
           asp-page="/UserProfiles/Index"
           asp-route-Search="@Model.Search"
           asp-route-CityId="@Model.CityId"
           asp-route-GenderId="@Model.GenderId"
           asp-route-ZodiacSignId="@Model.ZodiacSignId"
           asp-route-IsActive="@Model.IsActive"
           asp-route-IsProfileComplete="@Model.IsProfileComplete"
           asp-route-Sort="@Model.Sort"
           asp-route-PageNumber="@(Model.PageNumber + 1)">بعدی</a>
    </nav>
</div>
