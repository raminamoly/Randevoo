@page "/platform/login"
@model Randevoo.Web.Pages.Platform.Account.LoginModel
@{
    ViewData["Title"] = "ورود";
}

<section class="rv-auth-panel">
    <p class="rv-eyebrow">ورود با موبایل</p>
    <h1>ورود سریع به راندوو</h1>
    <p>شماره موبایل را وارد کن. کد یک‌بارمصرف برای همان شماره ارسال می‌شود.</p>
    @if (Model.ShowDevelopmentHint)
    {
        <div class="rv-detail-section rv-detail-section--success">
            <strong>ورود توسعه‌ای</strong>
            <p>شماره تست: <span class="rv-number">09120000000</span>، کد ثابت: <span class="rv-number">123456</span></p>
        </div>
    }

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning rv-alert" role="alert">@Model.ErrorMessage</div>
    }
    @if (Model.SuccessMessage is not null)
    {
        <div class="alert alert-success rv-alert" role="status">@Model.SuccessMessage</div>
    }

    <form method="post" class="rv-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <label asp-for="MobileNumber">شماره موبایل</label>
        <input asp-for="MobileNumber" class="form-control rv-ltr-input" inputmode="tel" autocomplete="tel" placeholder="+989121234567" />
        <span asp-validation-for="MobileNumber" class="text-danger"></span>

        @if (Model.CodeRequested)
        {
            <label asp-for="Code">کد ورود</label>
            <input asp-for="Code" class="form-control rv-ltr-input" inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
            <span asp-validation-for="Code" class="text-danger"></span>
            <button class="btn btn-primary btn-lg" type="submit" asp-page-handler="VerifyCode">
                <i class="bi bi-box-arrow-in-left" aria-hidden="true"></i>
                <span>ورود</span>
            </button>
            <button class="btn btn-link" type="submit" asp-page-handler="RequestCode">
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                <span>ارسال دوباره کد</span>
            </button>
        }
        else
        {
            <button class="btn btn-primary btn-lg" type="submit" asp-page-handler="RequestCode">
                <i class="bi bi-chat-dots" aria-hidden="true"></i>
                <span>دریافت کد</span>
            </button>
        }
    </form>
</section>
