<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - راندوو</title>
    <script type="importmap"></script>
    <link rel="preload" href="~/fonts/iransansx/IRANSansXV.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/typography.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Randevoo.Web.styles.css" asp-append-version="true" />
</head>
@{
    var requestPath = Context.Request.Path.Value ?? "/";
    var isPlatform = requestPath.StartsWith("/platform", StringComparison.OrdinalIgnoreCase);
    var isPlatformLogin = requestPath.StartsWith("/platform/login", StringComparison.OrdinalIgnoreCase);
}
<body>
    <header class="rv-topbar">
        <nav class="container rv-shell d-flex align-items-center justify-content-between">
            <a class="rv-brand" asp-area="" asp-page="/Index" aria-label="راندوو">
                <img src="~/images/logo.png" alt="" class="rv-brand__logo" />
                <span>راندوو</span>
            </a>
            @if (isPlatform)
            {
                <a class="btn btn-sm btn-outline-primary" asp-area="" asp-page="/Events/Index">
                    <i class="bi bi-globe2" aria-hidden="true"></i>
                    <span>وبسایت</span>
                </a>
            }
            else
            {
                <div class="rv-website-nav">
                    <a asp-page="/Events/Index">رویدادها</a>
                    <a class="btn btn-sm btn-primary" asp-area="" asp-page="/Platform/Account/Login">
                        <i class="bi bi-phone" aria-hidden="true"></i>
                        <span>ورود</span>
                    </a>
                </div>
            }
        </nav>
    </header>

    <main class="container rv-main @(isPlatform ? "rv-main--platform" : "rv-main--website")" role="main">
        @RenderBody()
    </main>

    @if (isPlatform && !isPlatformLogin)
    {
        <nav class="rv-bottom-nav" aria-label="ناوبری اصلی پلتفرم">
            <a asp-page="/Platform/Events/Index" class="rv-bottom-nav__item">
                <i class="bi bi-calendar-heart" aria-hidden="true"></i>
                <span>رویدادها</span>
            </a>
            <a asp-page="/Platform/Tickets/Index" class="rv-bottom-nav__item">
                <i class="bi bi-ticket-perforated" aria-hidden="true"></i>
                <span>بلیت‌ها</span>
            </a>
            <a asp-page="/Platform/Notifications/Index" class="rv-bottom-nav__item">
                <i class="bi bi-bell" aria-hidden="true"></i>
                <span>پیام‌ها</span>
            </a>
            <a asp-page="/Platform/Profile/Index" class="rv-bottom-nav__item">
                <i class="bi bi-person-circle" aria-hidden="true"></i>
                <span>حساب</span>
            </a>
        </nav>
    }
    else if (!isPlatform)
    {
        <footer class="rv-website-footer">
            <div class="container rv-website-footer__inner">
                <span>راندوو</span>
                <a asp-page="/Events/Index">رویدادها</a>
                <a asp-page="/Platform/Account/Login">ورود به پلتفرم</a>
            </div>
        </footer>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
